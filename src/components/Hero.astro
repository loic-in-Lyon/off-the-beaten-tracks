---
import { Image } from "astro:assets";
import illustrationCafe from "../assets/images/illustration-cafe.png";
---

<section
    class="relative py-16 md:py-24 bg-[#FAF8F5] overflow-hidden border-b border-obt-muted/10"
>
    <!-- Halo doux en arrière-plan (Vert Asso & Violet Blog) -->
    <div
        class="absolute top-1/4 -left-20 w-80 h-80 bg-[var(--color-asso-light)] rounded-full blur-3xl opacity-60 pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-10 right-10 w-96 h-96 bg-[var(--color-blog-light)] rounded-full blur-3xl opacity-50 pointer-events-none"
    >
    </div>

    <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
    >
        <!-- Texte d'accroche centré sur l'asso -->
        <div class="lg:col-span-7 space-y-8 text-left">
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-asso-light)] text-[var(--color-asso-text)] border border-[var(--color-asso)]/30 shadow-sm"
            >
                <span
                    class="flex h-2 w-2 rounded-full bg-[var(--color-asso)] animate-pulse"
                ></span>
                <span class="font-extrabold text-xs tracking-wider uppercase"
                    >Association Off The Beaten Tracks</span
                >
            </div>

            <h1
                class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-obt-dark leading-[1.15] font-serif"
            >
                Cultiver l'interculturel, <br class="hidden sm:inline" />
                <span class="text-[var(--color-asso-text)]">créer du lien</span> &
                agir ensemble.
            </h1>

            <p class="text-lg text-obt-muted leading-relaxed max-w-xl">
                L'association <strong>Off The Beaten Tracks</strong> rassemble les
                citoyennes et citoyens autour de projets culturels, d'ateliers et
                d'échanges. Notre lieu de vie, l'<strong>OBT Café</strong> à Lyon
                3e, est le point de rencontre ouvert à toutes et tous pour concrétiser
                ces engagements.
            </p>

            <!-- 3 Piliers de l'association -->
            <div
                class="grid grid-cols-3 gap-4 pt-1 max-w-lg text-xs font-bold text-obt-dark border-y border-obt-muted/10 py-4"
            >
                <div class="flex items-center gap-2">
                    <span class="text-base">🌍</span>
                    <span>Interculturalité</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-base">🤝</span>
                    <span>Projets citoyens</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-base">☕</span>
                    <span>Un tiers-lieu ouvert</span>
                </div>
            </div>

            <!-- Boutons d'action : Asso en 1er, Café en 2nd -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
                <a
                    href="/association"
                    class="px-8 py-3.5 rounded-full bg-[var(--color-asso)] text-white font-extrabold text-xs uppercase tracking-wider hover:opacity-90 hover:scale-[1.02] active:scale-95 transition-all shadow-md"
                >
                    Découvrir l'association →
                </a>
                <a
                    href="/le-cafe"
                    class="px-8 py-3.5 rounded-full bg-cafe-light text-cafe-text font-extrabold text-xs uppercase tracking-wider hover:bg-cafe hover:text-white transition-all border border-cafe/30 shadow-sm"
                >
                    Visiter le café
                </a>
            </div>
        </div>

        <!-- Visuel & Badge Asso -->
        <div class="lg:col-span-5 relative flex justify-center items-center">
            <div
                class="absolute w-[300px] h-[300px] sm:w-[400px] sm:h-[400px] bg-[var(--color-asso-light)] border border-[var(--color-asso)]/20 rounded-full blur-sm -z-10"
            >
            </div>

            <div class="relative w-full max-w-md">
                <Image
                    src={illustrationCafe}
                    alt="Illustration de la communauté Off The Beaten Tracks"
                    width={600}
                    height={500}
                    class="w-full h-auto object-contain transition-transform duration-500 hover:scale-105"
                    loading="eager"
                />

                <!-- Badge d'ancrage territorial -->
                <div
                    class="absolute -bottom-4 -left-4 sm:left-0 bg-white/95 backdrop-blur-sm p-3.5 rounded-2xl border border-obt-muted/15 shadow-lg flex items-center gap-3"
                >
                    <span class="text-2xl">🌱</span>
                    <div class="text-left">
                        <p class="text-xs font-extrabold text-obt-dark">
                            Espace Associatif & Solidaire
                        </p>
                        <p class="text-[10px] text-obt-muted">
                            236 Cours Lafayette, Lyon 3e
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
