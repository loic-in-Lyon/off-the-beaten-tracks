---
import { getCollection } from "astro:content";

interface Props {
    limit?: number;
}

const { limit = 3 } = Astro.props;

const allPosts = await getCollection("blog");
const recentPosts = allPosts
    .filter((p) => !p.data.draft)
    .sort(
        (a, b) =>
            new Date(b.data.publishDate).getTime() -
            new Date(a.data.publishDate).getTime(),
    )
    .slice(0, limit);
---

{
    recentPosts.length > 0 && (
        <section class="py-16 bg-obt-light">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-obt-muted/10 pb-6">
                    <div>
                        <span class="text-obt-secondary font-bold text-xs tracking-wider uppercase">
                            Actualités
                        </span>
                        <h2 class="text-3xl font-extrabold text-obt-dark mt-1">
                            Derniers articles
                        </h2>
                    </div>
                    <a
                        href="/blog"
                        class="text-sm font-semibold text-obt-secondary hover:underline"
                    >
                        Voir tous les articles →
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {recentPosts.map((post) => (
                        <article class="bg-white rounded-3xl p-6 border border-obt-muted/10 flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
                            <div class="space-y-3">
                                <span class="text-xs font-bold text-obt-primary uppercase tracking-wide">
                                    {post.data.category}
                                </span>
                                <h3 class="text-xl font-bold text-obt-dark">
                                    <a
                                        href={`/blog/${post.id}`}
                                        class="hover:text-obt-primary transition-colors"
                                    >
                                        {post.data.title}
                                    </a>
                                </h3>
                                <p class="text-obt-muted text-sm line-clamp-3">
                                    {post.data.description}
                                </p>
                            </div>
                            <div class="pt-6 mt-4 border-t border-obt-muted/10 text-xs text-obt-muted">
                                Publié le{" "}
                                {new Date(
                                    post.data.publishDate,
                                ).toLocaleDateString("fr-FR", {
                                    day: "numeric",
                                    month: "long",
                                    year: "numeric",
                                })}
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )
}
