---
import { Image } from "astro:assets";
import barImg from "../assets/images/bar.jpg";
import biblioImg from "../assets/images/bibliotheque.jpeg";
---

<section class="py-24 bg-white border-b border-obt-muted/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <!-- Gauche : Textes & CTA vers /le-cafe -->
            <div class="lg:col-span-5 space-y-6">
                <span
                    class="inline-block px-3.5 py-1.5 rounded-full bg-cafe-light text-cafe-text font-extrabold text-xs tracking-wider uppercase border border-cafe/20"
                >
                    LE TIERS-LIEU
                </span>

                <h2
                    class="text-3xl sm:text-4xl font-extrabold text-obt-dark tracking-tight leading-tight font-serif"
                >
                    Un café vivant, chaleureux & engagé
                </h2>

                <p class="text-obt-muted leading-relaxed text-base">
                    Plus qu’un simple bar, l’<strong>OBT Café</strong> est un espace
                    d'accueil citoyen au cœur du 3ᵉ arrondissement de Lyon. On y vient
                    pour boire un verre solidaire, bouquiner, travailler ou simplement
                    partager un moment spontané.
                </p>

                <ul class="space-y-3 pt-2 text-sm text-obt-dark font-medium">
                    <li class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cafe"></span>
                        <span
                            >Boissons locales, bios et restauration conviviale</span
                        >
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cafe"></span>
                        <span
                            >Espace bibliothèque, jeux de société & Wi-Fi
                            gratuit</span
                        >
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-cafe"></span>
                        <span
                            >Ateliers récurrents (Singa Blabla, cours de
                            danse...)</span
                        >
                    </li>
                </ul>

                <div class="pt-4">
                    <a
                        href="/le-cafe"
                        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-cafe-text text-white font-bold text-xs uppercase tracking-wider hover:opacity-90 shadow-md transition-all group"
                    >
                        <span>Découvrir le Café & les horaires</span>
                        <span
                            class="ml-2 transition-transform group-hover:translate-x-1"
                            >→</span
                        >
                    </a>
                </div>
            </div>

            <!-- Droite : Montage photos du café -->
            <div class="lg:col-span-7 grid grid-cols-2 gap-4 relative">
                <div class="space-y-4">
                    <div
                        class="rounded-2xl overflow-hidden border border-obt-muted/15 shadow-sm"
                    >
                        <Image
                            src={barImg}
                            alt="Comptoir du café OBT"
                            width={500}
                            height={600}
                            class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500"
                        />
                    </div>
                </div>
                <div class="space-y-4 pt-8">
                    <div
                        class="rounded-2xl overflow-hidden border border-obt-muted/15 shadow-sm"
                    >
                        <Image
                            src={biblioImg}
                            alt="Espace bibliothèque et détente du café"
                            width={500}
                            height={600}
                            class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
