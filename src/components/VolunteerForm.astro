---
interface Props {
    accessKey?: string;
}

const { accessKey = "3c63b09b-10a9-4d99-90be-ae2a1526a863" } = Astro.props;
---

<div
    class="bg-white p-6 sm:p-8 rounded-3xl border border-obt-muted/20 shadow-sm"
>
    <div class="text-center mb-6 space-y-1">
        <h2 class="text-xl md:text-2xl font-bold text-obt-dark">
            Formulaire de bénévolat
        </h2>
        <p class="text-xs text-obt-muted">
            Remplissez ce questionnaire, nous vous recontacterons très vite !
        </p>
    </div>

    <form id="volunteer-form" class="space-y-4">
        <input type="hidden" name="access_key" value={accessKey} />
        <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
        />
        <input
            type="hidden"
            name="subject"
            value="Nouvelle candidature bénévole - OBT Café"
        />
        <input type="hidden" name="from_name" value="OBT Café (Bénévolat)" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label
                    for="firstname"
                    class="block text-[11px] font-bold uppercase tracking-wider text-obt-dark mb-1"
                    >Prénom *</label
                >
                <input
                    type="text"
                    id="firstname"
                    name="firstname"
                    required
                    placeholder="Votre prénom"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-obt-light border border-obt-muted/20 text-xs text-obt-dark focus:outline-none focus:ring-2 focus:ring-obt-primary"
                />
            </div>
            <div>
                <label
                    for="lastname"
                    class="block text-[11px] font-bold uppercase tracking-wider text-obt-dark mb-1"
                    >Nom *</label
                >
                <input
                    type="text"
                    id="lastname"
                    name="lastname"
                    required
                    placeholder="Votre nom"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-obt-light border border-obt-muted/20 text-xs text-obt-dark focus:outline-none focus:ring-2 focus:ring-obt-primary"
                />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label
                    for="email"
                    class="block text-[11px] font-bold uppercase tracking-wider text-obt-dark mb-1"
                    >Email *</label
                >
                <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="votre.email@exemple.fr"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-obt-light border border-obt-muted/20 text-xs text-obt-dark focus:outline-none focus:ring-2 focus:ring-obt-primary"
                />
            </div>
            <div>
                <label
                    for="phone"
                    class="block text-[11px] font-bold uppercase tracking-wider text-obt-dark mb-1"
                    >Téléphone</label
                >
                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="06 00 00 00 00"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-obt-light border border-obt-muted/20 text-xs text-obt-dark focus:outline-none focus:ring-2 focus:ring-obt-primary"
                />
            </div>
        </div>

        <div>
            <label
                class="block text-[11px] font-bold uppercase tracking-wider text-obt-dark mb-1.5"
                >Ce qui vous intéresse :</label
            >
            <div
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-obt-dark"
            >
                <label
                    class="flex items-center gap-2 p-2.5 rounded-xl border border-obt-muted/20 hover:bg-obt-light cursor-pointer"
                >
                    <input
                        type="checkbox"
                        name="interests"
                        value="Accueil & Bar"
                        class="rounded text-obt-primary focus:ring-obt-primary"
                    />
                    <span>Accueil & Tenue du bar</span>
                </label>
                <label
                    class="flex items-center gap-2 p-2.5 rounded-xl border border-obt-muted/20 hover:bg-obt-light cursor-pointer"
                >
                    <input
                        type="checkbox"
                        name="interests"
                        value="Animation Ateliers"
                        class="rounded text-obt-primary focus:ring-obt-primary"
                    />
                    <span>Animation d'ateliers / Événements</span>
                </label>
                <label
                    class="flex items-center gap-2 p-2.5 rounded-xl border border-obt-muted/20 hover:bg-obt-light cursor-pointer"
                >
                    <input
                        type="checkbox"
                        name="interests"
                        value="Communication"
                        class="rounded text-obt-primary focus:ring-obt-primary"
                    />
                    <span>Communication / Réseaux sociaux</span>
                </label>
                <label
                    class="flex items-center gap-2 p-2.5 rounded-xl border border-obt-muted/20 hover:bg-obt-light cursor-pointer"
                >
                    <input
                        type="checkbox"
                        name="interests"
                        value="Logistique & Bricolage"
                        class="rounded text-obt-primary focus:ring-obt-primary"
                    />
                    <span>Bricolage / Logistique / Projets</span>
                </label>
            </div>
        </div>

        <div>
            <label
                for="message"
                class="block text-[11px] font-bold uppercase tracking-wider text-obt-dark mb-1"
                >Quelques mots sur vous / vos motivations *</label
            >
            <textarea
                id="message"
                name="message"
                rows="3"
                required
                placeholder="Dites-nous ce qui vous amène au café, vos disponibilités ou vos idées..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-obt-light border border-obt-muted/20 text-xs text-obt-dark focus:outline-none focus:ring-2 focus:ring-obt-primary"
            ></textarea>
        </div>

        <div class="flex items-start gap-2.5 pt-1">
            <input
                type="checkbox"
                id="privacy-volunteer"
                name="privacy"
                required
                class="mt-0.5 h-3.5 w-3.5 rounded border-obt-muted/30 text-obt-primary focus:ring-obt-primary cursor-pointer"
            />
            <label
                for="privacy-volunteer"
                class="text-[11px] text-obt-muted leading-tight"
            >
                J'accepte que mes informations soient traitées conformément à la
                <a
                    href="/politique-de-confidentialite"
                    target="_blank"
                    class="text-obt-primary underline font-medium"
                    >politique de confidentialité</a
                >.
            </label>
        </div>

        <div
            id="volunteer-error"
            class="hidden p-3 rounded-xl text-center text-xs font-medium bg-red-50 text-red-800 border border-red-200"
        >
        </div>

        <button
            type="submit"
            id="volunteer-submit-btn"
            class="w-full py-3 rounded-full bg-obt-primary text-white font-bold text-xs hover:bg-obt-primary/90 shadow transition-all cursor-pointer disabled:opacity-50 mt-2"
        >
            Envoyer ma candidature 🚀
        </button>
    </form>

    <div id="volunteer-success" class="hidden text-center py-8 space-y-4">
        <div
            class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-3xl shadow-inner"
        >
            ✓
        </div>
        <div class="space-y-1">
            <h3 class="text-xl font-extrabold text-obt-dark">
                Candidature bien reçue !
            </h3>
            <p class="text-obt-muted text-xs max-w-xs mx-auto leading-relaxed">
                Merci pour votre intérêt ! L'équipe vous recontactera
                rapidement.
            </p>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById("volunteer-form") as HTMLFormElement;
    const successDiv = document.getElementById("volunteer-success");
    const errorDiv = document.getElementById("volunteer-error");
    const submitBtn = document.getElementById(
        "volunteer-submit-btn",
    ) as HTMLButtonElement;

    if (form && successDiv && errorDiv && submitBtn) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            errorDiv.classList.add("hidden");
            submitBtn.disabled = true;
            submitBtn.innerText = "Envoi en cours...";

            const formData = new FormData(form);
            const json = JSON.stringify(Object.fromEntries(formData));

            try {
                const response = await fetch(
                    "https://api.web3forms.com/submit",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                        },
                        body: json,
                    },
                );

                const result = await response.json();

                if (response.status === 200 && result.success) {
                    form.classList.add("hidden");
                    successDiv.classList.remove("hidden");
                    form.reset();
                } else {
                    errorDiv.innerText =
                        result.message ||
                        "Un problème est survenu lors de l'envoi. Veuillez réessayer.";
                    errorDiv.classList.remove("hidden");
                }
            } catch (error) {
                errorDiv.innerText =
                    "Erreur de connexion. Veuillez vérifier votre réseau.";
                errorDiv.classList.remove("hidden");
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerText = "Envoyer ma candidature 🚀";
            }
        });
    }
</script>
