---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    event: CollectionEntry<"events">;
    isPast?: boolean;
}

const { event, isPast = false } = Astro.props;

const formattedDate = new Date(event.data.date).toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
});

// Vérification du type de l'image (Objet importé Astro vs Chemin texte Keystatic)
const isAstroImage = typeof event.data.image !== "string";
---

<article
    class={`bg-white rounded-3xl overflow-hidden border border-obt-muted/15 flex flex-col justify-between shadow-sm hover:shadow-md transition-all ${isPast ? "opacity-75 hover:opacity-100" : ""}`}
>
    <div>
        <div class="relative h-48 overflow-hidden">
            {
                isAstroImage ? (
                    <Image
                        src={event.data.image}
                        alt={event.data.title}
                        width={600}
                        height={400}
                        class={`w-full h-full object-cover transition-transform duration-300 hover:scale-105 ${isPast ? "grayscale hover:grayscale-0" : ""}`}
                    />
                ) : (
                    <img
                        src={event.data.image}
                        alt={event.data.title}
                        class={`w-full h-full object-cover transition-transform duration-300 hover:scale-105 ${isPast ? "grayscale hover:grayscale-0" : ""}`}
                    />
                )
            }

            <!-- Badges harmonieux sur l'image -->
            <div class="absolute top-3 left-3 flex flex-wrap gap-2">
                <!-- Badge Catégorie / Statut Passé -->
                <span
                    class={`text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm ${
                        isPast
                            ? "bg-slate-700 text-white"
                            : "bg-[var(--color-event)] text-[var(--color-event-text)]"
                    }`}
                >
                    {isPast ? "Passé" : event.data.category}
                </span>

                <!-- Badge Récurrence -->
                {
                    !isPast && (
                        <span class="text-xs font-bold px-3 py-1 rounded-full shadow-sm bg-[var(--color-event-light)] text-[var(--color-event-text)] border border-[var(--color-event)]/40 backdrop-blur-sm">
                            {event.data.isRecurring
                                ? event.data.frequency
                                    ? `🔄 ${event.data.frequency}`
                                    : "🔄 Récurrent"
                                : "📍 Date unique"}
                        </span>
                    )
                }
            </div>
        </div>

        <div class="p-6 space-y-2">
            <!-- Date -->
            <div
                class="text-xs font-bold text-[var(--color-event-text)] flex items-center gap-1.5"
            >
                <span>📅</span>
                <span>
                    {
                        event.data.isRecurring && event.data.frequency
                            ? `${event.data.frequency} à ${new Date(event.data.date).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}`
                            : formattedDate
                    }
                </span>
            </div>

            <h3 class="text-xl font-bold text-obt-dark font-serif leading-snug">
                {event.data.title}
            </h3>

            <p class="text-obt-muted text-sm line-clamp-2 leading-relaxed">
                {event.data.description}
            </p>
        </div>
    </div>

    <div class="p-6 pt-0">
        <a
            href={`/events/${event.id}`}
            class={`block text-center w-full py-2.5 rounded-full text-sm font-bold transition-all ${
                isPast
                    ? "border border-obt-muted/30 text-obt-dark hover:bg-obt-light"
                    : "bg-[var(--color-event)] text-[var(--color-event-text)] hover:brightness-95 shadow-sm"
            }`}
        >
            {isPast ? "Voir les détails →" : "En savoir plus →"}
        </a>
    </div>
</article>
