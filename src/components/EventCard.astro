---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    event: CollectionEntry<"events">;
    isPast?: boolean;
}

const { event, isPast = false } = Astro.props;

const formattedDate = new Date(event.data.date).toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
});
---

<article
    class={`bg-obt-light rounded-3xl overflow-hidden border border-obt-muted/15 flex flex-col justify-between shadow-sm hover:shadow-md transition-all ${isPast ? "opacity-80 hover:opacity-100" : ""}`}
>
    <div>
        <div class="relative h-48 overflow-hidden">
            <Image
                src={event.data.image}
                alt={event.data.title}
                width={600}
                height={400}
                class={`w-full h-full object-cover ${isPast ? "grayscale hover:grayscale-0 transition-all" : ""}`}
            />

            <!-- Badges sur l'image -->
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                <!-- Badge Catégorie / Statut passé -->
                <span
                    class={`text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide shadow-sm ${isPast ? "bg-obt-muted" : "bg-obt-primary"}`}
                >
                    {isPast ? "Passé" : event.data.category}
                </span>

                <!-- Badge Récurrent vs Ponctuel -->
                {
                    !isPast && (
                        <span
                            class={`text-xs font-bold px-3 py-1 rounded-full shadow-sm ${
                                event.data.isRecurring
                                    ? "bg-purple-700 text-white"
                                    : "bg-emerald-600 text-white"
                            }`}
                        >
                            {event.data.isRecurring
                                ? event.data.frequency
                                    ? `🔄 ${event.data.frequency}`
                                    : "🔄 Récurrent"
                                : "📍 Date unique"}
                        </span>
                    )
                }
            </div>
        </div>

        <div class="p-6 space-y-2">
            <div
                class="text-xs font-semibold text-obt-secondary flex items-center gap-1"
            >
                <span>📅</span>
                <span>
                    {
                        event.data.isRecurring && event.data.frequency
                            ? `${event.data.frequency} à ${new Date(event.data.date).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}`
                            : formattedDate
                    }
                </span>
            </div>
            <h3 class="text-xl font-bold text-obt-dark">{event.data.title}</h3>
            <p class="text-obt-muted text-sm line-clamp-2">
                {event.data.description}
            </p>
        </div>
    </div>

    <div class="p-6 pt-0">
        <a
            href={`/events/${event.id}`}
            class={`block text-center w-full py-2.5 rounded-full text-sm font-medium transition-all ${
                isPast
                    ? "border border-obt-muted/30 text-obt-dark hover:bg-obt-light"
                    : "bg-obt-primary text-white hover:bg-obt-primary/90"
            }`}
        >
            {isPast ? "Voir les détails →" : "En savoir plus →"}
        </a>
    </div>
</article>
