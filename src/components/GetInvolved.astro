<section
    class="py-24 bg-white border-t border-obt-muted/10 relative overflow-hidden"
>
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 relative z-10"
    >
        <!-- En-tête de section -->
        <div class="text-center max-w-2xl mx-auto space-y-3">
            <span
                class="inline-block px-3.5 py-1.5 rounded-full bg-[var(--color-action-light)] text-action font-extrabold text-xs tracking-wider uppercase border border-action/20 shadow-sm"
            >
                AGIR AVEC NOUS
            </span>
            <h2
                class="text-3xl sm:text-4xl font-extrabold font-serif tracking-tight text-obt-dark"
            >
                Soutenez l'aventure OBT
            </h2>
            <p class="text-obt-muted text-base leading-relaxed">
                Que ce soit en donnant de votre temps ou en contribuant
                financièrement, chaque geste aide à maintenir notre espace
                ouvert, gratuit et accessible à tous.
            </p>
        </div>

        <!-- Deux cartes d'action -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
            <!-- Carte 1 : Bénévolat -->
            <div
                class="bg-obt-light/50 border border-obt-muted/15 rounded-3xl p-8 sm:p-10 shadow-sm flex flex-col justify-between space-y-8 hover:border-action/30 transition-all group"
            >
                <div class="space-y-4">
                    <div
                        class="w-12 h-12 rounded-2xl bg-action/10 flex items-center justify-center text-action border border-action/20"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-obt-dark">
                        Devenir bénévole
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Rejoignez une équipe dynamique pour animer des ateliers,
                        accueillir le public au café, organiser des événements
                        ou partager vos compétences.
                    </p>
                </div>

                <div>
                    <a
                        href="/benevolat"
                        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-obt-dark text-white font-bold text-xs uppercase tracking-wider hover:bg-action transition-all shadow-md group-hover:shadow-lg w-full sm:w-auto text-center"
                    >
                        <span>Rejoindre l'équipe</span>
                        <span
                            class="ml-2 transition-transform group-hover:translate-x-1"
                            >→</span
                        >
                    </a>
                </div>
            </div>

            <!-- Carte 2 : Don / Soutien -->
            <div
                class="bg-obt-light/50 border border-obt-muted/15 rounded-3xl p-8 sm:p-10 shadow-sm flex flex-col justify-between space-y-8 hover:border-action/30 transition-all group"
            >
                <div class="space-y-4">
                    <div
                        class="w-12 h-12 rounded-2xl bg-action/10 flex items-center justify-center text-action border border-action/20"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-serif font-bold text-obt-dark">
                        Faire un don
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Vos dons nous permettent d'offrir des boissons
                        solidaires, de financer le matériel des ateliers et de
                        faire vivre ce projet indépendant.
                    </p>
                </div>

                <div>
                    <a
                        href="/faire-un-don"
                        class="inline-flex items-center justify-center px-6 py-3.5 rounded-full bg-action text-white font-bold text-xs uppercase tracking-wider hover:bg-action-text transition-all shadow-md group-hover:shadow-lg w-full sm:w-auto text-center"
                    >
                        <span>Soutenir l'association</span>
                        <span
                            class="ml-2 transition-transform group-hover:translate-x-1"
                            >→</span
                        >
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
