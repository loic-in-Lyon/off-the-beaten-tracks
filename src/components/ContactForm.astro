---
const web3formsKey = "3c63b09b-10a9-4d99-90be-ae2a1526a863";
---

<div
    class="bg-white p-8 sm:p-10 rounded-3xl border border-obt-muted/15 shadow-sm relative"
>
    <!-- Formulaire -->
    <form id="contact-form" class="space-y-6">
        <!-- Clé & Paramètres cachés Web3Forms -->
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
        />
        <input
            type="hidden"
            name="subject"
            value="Nouveau message depuis le site de l'Association OBT"
        />

        <!-- Nom -->
        <div class="space-y-2">
            <label
                for="name"
                class="block text-xs font-bold uppercase tracking-wider text-obt-dark"
                >Nom complet</label
            >
            <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Votre nom et prénom"
                class="w-full px-4 py-3.5 rounded-2xl bg-obt-light border border-obt-muted/15 focus:outline-none focus:border-action focus:ring-2 focus:ring-action/10 text-sm text-obt-dark transition-all"
            />
        </div>

        <!-- Email -->
        <div class="space-y-2">
            <label
                for="email"
                class="block text-xs font-bold uppercase tracking-wider text-obt-dark"
                >Adresse e-mail</label
            >
            <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="votre@email.com"
                class="w-full px-4 py-3.5 rounded-2xl bg-obt-light border border-obt-muted/15 focus:outline-none focus:border-action focus:ring-2 focus:ring-action/10 text-sm text-obt-dark transition-all"
            />
        </div>

        <!-- Objet -->
        <div class="space-y-2">
            <label
                for="category"
                class="block text-xs font-bold uppercase tracking-wider text-obt-dark"
                >Objet de votre demande</label
            >
            <select
                id="category"
                name="category"
                class="w-full px-4 py-3.5 rounded-2xl bg-obt-light border border-obt-muted/15 focus:outline-none focus:border-action focus:ring-2 focus:ring-action/10 text-sm text-obt-dark transition-all cursor-pointer"
            >
                <option value="Renseignement général"
                    >Renseignement général</option
                >
                <option value="Privatisation de salle"
                    >Privatisation & Espace associatif</option
                >
                <option value="Proposition de projet / Concert / Atelier"
                    >Proposer un projet, atelier ou concert</option
                >
                <option value="Bénévolat">Devenir bénévole</option>
            </select>
        </div>

        <!-- Message -->
        <div class="space-y-2">
            <label
                for="message"
                class="block text-xs font-bold uppercase tracking-wider text-obt-dark"
                >Votre message</label
            >
            <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Expliquez-nous votre demande, votre projet ou vos disponibilités..."
                class="w-full px-4 py-3.5 rounded-2xl bg-obt-light border border-obt-muted/15 focus:outline-none focus:border-action focus:ring-2 focus:ring-action/10 text-sm text-obt-dark transition-all resize-y"
            ></textarea>
        </div>

        <!-- Case à cocher Politique de confidentialité -->
        <div class="flex items-start gap-3 pt-1">
            <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="mt-1 h-4 w-4 rounded border-obt-muted/30 text-action focus:ring-action cursor-pointer accent-[var(--color-action)]"
            />
            <label for="privacy" class="text-xs text-obt-muted leading-relaxed">
                J'accepte que mes données soient traitées conformément à la
                <a
                    href="/politique-de-confidentialite"
                    target="_blank"
                    class="text-action underline font-medium hover:opacity-80"
                >
                    politique de confidentialité
                </a>.
            </label>
        </div>

        <!-- Message d'erreur (si problème lors de l'envoi) -->
        <div
            id="error-message"
            class="hidden p-4 rounded-2xl text-center text-sm font-medium bg-red-50 text-red-800 border border-red-200"
        >
        </div>

        <!-- Bouton d'envoi -->
        <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 rounded-full bg-action text-white font-bold hover:bg-action-text transition-all text-xs uppercase tracking-wider shadow-md disabled:opacity-50 cursor-pointer flex items-center justify-center gap-2 group"
        >
            <span>Envoyer le message</span>
            <span class="transition-transform group-hover:translate-x-1">→</span
            >
        </button>
    </form>

    <!-- État de confirmation (Masqué par défaut) -->
    <div id="success-feedback" class="hidden text-center py-12 px-4 space-y-6">
        <div
            class="w-16 h-16 bg-[var(--color-action-light)] text-action rounded-full flex items-center justify-center mx-auto shadow-sm border border-action/20"
        >
            <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M5 13l4 4L19 7"></path>
            </svg>
        </div>
        <div class="space-y-2">
            <h3 class="text-2xl font-serif font-bold text-obt-dark">
                Message bien envoyé !
            </h3>
            <p class="text-obt-muted text-sm max-w-md mx-auto leading-relaxed">
                Merci de nous avoir contactés. L'équipe de l'association vous
                répondra par e-mail dans les plus brefs délais.
            </p>
        </div>
        <div>
            <button
                type="button"
                id="reset-form-btn"
                class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-obt-muted/20 text-obt-dark text-xs font-bold uppercase tracking-wider hover:bg-obt-light transition-all cursor-pointer"
            >
                Envoyer un autre message
            </button>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const successFeedback = document.getElementById("success-feedback");
    const errorMessage = document.getElementById("error-message");
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement;
    const resetBtn = document.getElementById("reset-form-btn");

    if (form && successFeedback && errorMessage && submitBtn) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Réinitialise le message d'erreur et désactive le bouton
            errorMessage.classList.add("hidden");
            submitBtn.disabled = true;
            const spanText = submitBtn.querySelector("span");
            if (spanText) spanText.innerText = "Envoi en cours...";

            const formData = new FormData(form);
            const json = JSON.stringify(Object.fromEntries(formData));

            try {
                const response = await fetch(
                    "https://api.web3forms.com/submit",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json",
                        },
                        body: json,
                    },
                );

                const result = await response.json();

                if (response.status === 200 && result.success) {
                    // Masque le formulaire et affiche le feedback élégant
                    form.classList.add("hidden");
                    successFeedback.classList.remove("hidden");
                    form.reset();
                } else {
                    errorMessage.innerText =
                        "Un problème est survenu lors de l'envoi. Veuillez réessayer ou nous contacter directement par e-mail.";
                    errorMessage.classList.remove("hidden");
                }
            } catch (error) {
                errorMessage.innerText =
                    "Erreur de connexion. Veuillez vérifier votre réseau puis réessayez.";
                errorMessage.classList.remove("hidden");
            } finally {
                submitBtn.disabled = false;
                if (spanText) spanText.innerText = "Envoyer le message";
            }
        });

        // Permet de réafficher le formulaire si l'utilisateur veut renvoyer un message
        if (resetBtn) {
            resetBtn.addEventListener("click", () => {
                successFeedback.classList.add("hidden");
                form.classList.remove("hidden");
            });
        }
    }
</script>
