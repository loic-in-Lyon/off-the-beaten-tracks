---
import { Image } from "astro:assets";
import logoImage from "../assets/images/logo.svg";

const pathname = new URL(Astro.request.url).pathname;
const currentPath =
    pathname.endsWith("/") && pathname.length > 1
        ? pathname.slice(0, -1)
        : pathname;

const isCafe =
    currentPath.startsWith("/le-cafe") || currentPath === "/location-salle";
const isAsso = currentPath === "/association" || currentPath === "/rejoindre";
const isEvents = currentPath.startsWith("/events");
const isBlog = currentPath.startsWith("/blog");
---

<header
    class="sticky top-0 z-50 bg-obt-light/80 backdrop-blur-xl border-b border-obt-border transition-all"
>
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between"
    >
        <!-- Logo & Marque -->
        <a
            href="/"
            class="flex items-center gap-3 group"
            aria-label="OBT Café - Accueil"
        >
            <div
                class="w-11 h-11 overflow-hidden flex items-center justify-center p-0.5 rounded-2xl transition-transform group-hover:scale-105"
            >
                <Image
                    src={logoImage}
                    alt="Logo OBT Café"
                    width={44}
                    height={44}
                    class="w-full h-full object-contain"
                />
            </div>
            <span
                class="text-xl font-bold tracking-tight text-obt-dark group-hover:text-asso transition-colors font-serif"
            >
                OBT Café
            </span>
        </a>

        <!-- Navigation Desktop avec Color Hinting -->
        <nav
            class="hidden md:flex items-center gap-8 font-medium text-sm text-obt-dark/75"
        >
            <!-- ☕ 1. Le Café (Terracotta) -->
            <div class="relative group py-2">
                <button
                    type="button"
                    class={`flex items-center gap-1.5 hover:text-cafe transition-colors focus:outline-none ${
                        isCafe ? "text-cafe-text font-bold" : ""
                    }`}
                >
                    <span>Le Café</span>
                    <span
                        class="w-1.5 h-1.5 rounded-full bg-cafe/40 inline-block"
                    ></span>
                    <svg
                        class="w-3.5 h-3.5 opacity-50 transition-transform group-hover:rotate-180"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>

                <div
                    class="absolute top-full left-0 w-52 bg-white rounded-2xl shadow-[0_12px_32px_rgba(0,0,0,0.06)] border border-obt-border p-2 hidden group-hover:block transition-all space-y-0.5"
                >
                    <a
                        href="/le-cafe"
                        class="block px-4 py-2.5 rounded-xl text-xs font-semibold text-obt-dark hover:bg-cafe-light hover:text-cafe-text transition-colors"
                    >
                        Présentation du Café
                    </a>
                    <a
                        href="/location-salle"
                        class="block px-4 py-2.5 rounded-xl text-xs font-semibold text-obt-dark hover:bg-cafe-light hover:text-cafe-text transition-colors"
                    >
                        Location de salle
                    </a>
                </div>
            </div>

            <!-- 🤝 2. L'Association (Sauge) -->
            <div class="relative group py-2">
                <button
                    type="button"
                    class={`flex items-center gap-1.5 hover:text-asso transition-colors focus:outline-none ${
                        isAsso ? "text-asso-text font-bold" : ""
                    }`}
                >
                    <span>L'Association</span>
                    <span
                        class="w-1.5 h-1.5 rounded-full bg-asso/40 inline-block"
                    ></span>
                    <svg
                        class="w-3.5 h-3.5 opacity-50 transition-transform group-hover:rotate-180"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>

                <div
                    class="absolute top-full left-0 w-56 bg-white rounded-2xl shadow-[0_12px_32px_rgba(0,0,0,0.06)] border border-obt-border p-2 hidden group-hover:block transition-all space-y-0.5"
                >
                    <a
                        href="/association"
                        class="block px-4 py-2.5 rounded-xl text-xs font-semibold text-obt-dark hover:bg-asso-light hover:text-asso-text transition-colors"
                    >
                        L'Association OBT
                    </a>
                    <a
                        href="/rejoindre"
                        class="block px-4 py-2.5 rounded-xl text-xs font-semibold text-obt-dark hover:bg-asso-light hover:text-asso-text transition-colors"
                    >
                        Nous rejoindre / Bénévolat
                    </a>
                </div>
            </div>

            <!-- 📅 3. Événements (Miel) -->
            <a
                href="/events"
                class={`flex items-center gap-1.5 hover:text-event transition-colors ${isEvents ? "text-event-text font-bold" : ""}`}
            >
                <span>Événements</span>
                <span class="w-1.5 h-1.5 rounded-full bg-event/40 inline-block"
                ></span>
            </a>

            <!-- 📝 4. Blog (Bleu Hortensia) -->
            <a
                href="/blog"
                class={`flex items-center gap-1.5 hover:text-blog transition-colors ${isBlog ? "text-blog-text font-bold" : ""}`}
            >
                <span>Blog</span>
                <span class="w-1.5 h-1.5 rounded-full bg-blog/40 inline-block"
                ></span>
            </a>
        </nav>

        <!-- CTAs -->
        <div class="hidden md:flex items-center gap-3">
            <a
                href="/rejoindre"
                class="px-5 py-2.5 rounded-full bg-asso-light text-asso-text font-semibold text-xs hover:bg-asso/20 transition-all border border-asso/20"
            >
                Devenir Bénévoles
            </a>
            <a
                href="/contact"
                class="px-6 py-2.5 rounded-full bg-cafe text-white font-semibold text-xs hover:bg-cafe-text shadow-[0_4px_14px_rgba(217,119,87,0.25)] transition-all hover:-translate-y-0.5"
            >
                Contact
            </a>
        </div>

        <!-- Burger Mobile -->
        <button
            id="menu-btn"
            class="md:hidden p-2.5 text-obt-dark focus:outline-none rounded-2xl hover:bg-obt-border/50 transition-colors ml-auto"
            aria-label="Ouvrir le menu"
        >
            <svg
                id="burger-icon-open"
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
            <svg
                id="burger-icon-close"
                class="w-6 h-6 hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path></svg
            >
        </button>
    </div>

    <!-- Tiroir Mobile -->
    <div
        id="mobile-menu"
        class="hidden md:hidden bg-white/95 backdrop-blur-xl border-b border-obt-border px-6 py-6 space-y-6 shadow-2xl rounded-b-3xl"
    >
        <nav class="space-y-5">
            <div class="space-y-2">
                <span
                    class="text-[10px] font-bold uppercase tracking-widest text-cafe-text bg-cafe-light px-2 py-0.5 rounded-full"
                    >Le Café</span
                >
                <div class="pl-3 space-y-2 border-l-2 border-cafe/40">
                    <a
                        href="/le-cafe"
                        class="block text-sm font-semibold text-obt-dark hover:text-cafe-text"
                        >Présentation du Café</a
                    >
                    <a
                        href="/location-salle"
                        class="block text-sm font-semibold text-obt-dark hover:text-cafe-text"
                        >Location de salle</a
                    >
                </div>
            </div>

            <div class="space-y-2">
                <span
                    class="text-[10px] font-bold uppercase tracking-widest text-asso-text bg-asso-light px-2 py-0.5 rounded-full"
                    >L'Association</span
                >
                <div class="pl-3 space-y-2 border-l-2 border-asso/40">
                    <a
                        href="/association"
                        class="block text-sm font-semibold text-obt-dark hover:text-asso-text"
                        >L'Association OBT</a
                    >
                    <a
                        href="/rejoindre"
                        class="block text-sm font-semibold text-obt-dark hover:text-asso-text"
                        >Nous rejoindre / Bénévolat</a
                    >
                </div>
            </div>

            <div class="pt-2 space-y-3">
                <a
                    href="/events"
                    class="block text-sm font-bold text-obt-dark hover:text-event-text"
                    >Événements</a
                >
                <a
                    href="/blog"
                    class="block text-sm font-bold text-obt-dark hover:text-blog-text"
                    >Blog</a
                >
            </div>
        </nav>
    </div>
</header>

<script>
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("burger-icon-open");
    const iconClose = document.getElementById("burger-icon-close");

    if (menuBtn && mobileMenu && iconOpen && iconClose) {
        menuBtn.addEventListener("click", () => {
            mobileMenu.classList.toggle("hidden");
            iconOpen.classList.toggle("hidden");
            iconClose.classList.toggle("hidden");
        });
    }
</script>
