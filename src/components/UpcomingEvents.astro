---
import { getCollection } from "astro:content";
import EventCard from "./EventCard.astro";

interface Props {
    limit?: number;
    title?: string;
    subtitle?: string;
    showViewAll?: boolean;
}

const {
    limit,
    title = "Prochains Événements",
    subtitle = "Rejoignez-nous lors de nos prochains rendez-vous culturels et conviviaux.",
    showViewAll = true,
} = Astro.props;

const allEvents = await getCollection("events");
const now = new Date();

let upcomingEvents = allEvents
    .filter((e) => new Date(e.data.date) >= now)
    .sort(
        (a, b) =>
            new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
    );

if (limit) {
    upcomingEvents = upcomingEvents.slice(0, limit);
}
---

<section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div
            class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-l-4 border-[var(--color-event)] pl-4"
        >
            <div class="space-y-1">
                <span
                    class="inline-block text-[var(--color-event-text)] font-extrabold text-xs tracking-wider uppercase"
                >
                    À ne pas manquer
                </span>
                <h2
                    class="text-2xl sm:text-3xl font-extrabold text-obt-dark font-serif"
                >
                    {title}
                </h2>
                {
                    subtitle && (
                        <p class="text-obt-muted text-sm mt-1">{subtitle}</p>
                    )
                }
            </div>
            {
                showViewAll && (
                    <div class="shrink-0 pt-2 sm:pt-0">
                        <a
                            href="/evenements"
                            class="inline-flex items-center text-sm font-bold text-[var(--color-event-text)] hover:opacity-80 transition-opacity"
                        >
                            Voir tout l'agenda →
                        </a>
                    </div>
                )
            }
        </div>

        {
            upcomingEvents.length === 0 ? (
                <div class="bg-[var(--color-event-light)] rounded-2xl p-8 text-center border border-[var(--color-event)]/20 space-y-2">
                    <p class="text-[var(--color-event-text)] font-semibold">
                        Aucun événement à venir pour le moment.
                    </p>
                    <p class="text-sm text-obt-muted">
                        Revenez très bientôt ou consultez nos réseaux sociaux !
                    </p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {upcomingEvents.map((event) => (
                        <EventCard event={event} />
                    ))}
                </div>
            )
        }
    </div>
</section>
