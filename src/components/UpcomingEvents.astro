---
import { getCollection } from "astro:content";
import EventCard from "./EventCard.astro";

interface Props {
    limit?: number;
    title?: string;
    subtitle?: string;
    showViewAll?: boolean;
}

const {
    limit,
    title = "Prochains Événements",
    subtitle = "Rejoignez-nous lors de nos prochains rendez-vous culturels et conviviaux.",
    showViewAll = true,
} = Astro.props;

const allEvents = await getCollection("events");

// Début de la journée actuelle (00:00:00) pour ne pas masquer les événements du jour même
const today = new Date();
today.setHours(0, 0, 0, 0);

let upcomingEvents = allEvents
    .filter((e) => {
        // On affiche l'événement si :
        // 1. C'est un atelier/événement récurrent (isRecurring)
        // 2. OU sa date est supérieure ou égale à aujourd'hui
        const eventDate = new Date(e.data.date);
        return e.data.isRecurring || eventDate >= today;
    })
    .sort(
        (a, b) =>
            new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
    );

if (limit) {
    upcomingEvents = upcomingEvents.slice(0, limit);
}
---

<section
    class="py-24 bg-[var(--color-event-light)]/30 border-b border-obt-muted/10"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <!-- En-tête aéré avec badge stylisé -->
        <div
            class="flex flex-col sm:flex-row sm:items-end justify-between gap-6"
        >
            <div class="space-y-3">
                <span
                    class="inline-block px-3.5 py-1.5 rounded-full bg-[var(--color-event-light)] text-[var(--color-event-text)] font-extrabold text-xs tracking-wider uppercase border border-[var(--color-event)]/20"
                >
                    À NE PAS MANQUER
                </span>
                <h2
                    class="text-3xl sm:text-4xl font-extrabold text-obt-dark font-serif tracking-tight"
                >
                    {title}
                </h2>
                {
                    subtitle && (
                        <p class="text-obt-muted text-base leading-relaxed max-w-2xl">
                            {subtitle}
                        </p>
                    )
                }
            </div>
            {
                showViewAll && (
                    <div class="shrink-0">
                        <a
                            href="/events"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-[var(--color-event-text)] border border-[var(--color-event)]/30 text-xs font-bold uppercase tracking-wider hover:bg-[var(--color-event-light)] transition-all shadow-sm group"
                        >
                            <span>Voir tout l'agenda</span>
                            <span class="transition-transform group-hover:translate-x-1">
                                →
                            </span>
                        </a>
                    </div>
                )
            }
        </div>

        {
            upcomingEvents.length === 0 ? (
                <div class="bg-white rounded-3xl p-12 text-center border border-obt-muted/15 shadow-sm space-y-3">
                    <p class="text-obt-dark font-bold text-lg font-serif">
                        Aucun événement programmé pour le moment
                    </p>
                    <p class="text-sm text-obt-muted max-w-md mx-auto">
                        Notre équipe prépare la suite des festivités. Revenez
                        très bientôt ou suivez-nous sur les réseaux !
                    </p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {upcomingEvents.map((event) => (
                        <EventCard event={event} />
                    ))}
                </div>
            )
        }
    </div>
</section>
