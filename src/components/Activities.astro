---
import { Image } from "astro:assets";
import talkshow from "../assets/images/talkshow.webp";
import danse from "../assets/images/danse.webp";
import scene from "../assets/images/scene.webp";
---

<section class="py-20 bg-white border-t border-obt-muted/10">
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-end justify-between mb-12"
    >
        <div>
            <span
                class="text-obt-primary font-bold text-sm tracking-wider uppercase"
                >ACTIVITÉS</span
            >
            <h2
                class="text-3xl sm:text-4xl font-extrabold text-obt-dark tracking-tight mt-2"
            >
                Les rendez-vous du café
            </h2>
        </div>
        <p class="text-obt-muted max-w-md mt-4 md:mt-0">
            Jusqu'à 4 activités par semaine : jeux, rencontres, ateliers et
            moments culturels ouverts à toutes et tous.
        </p>
    </div>

    <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
        <div
            class="group rounded-2xl overflow-hidden bg-obt-light border border-obt-muted/10 shadow-sm flex flex-col"
        >
            <div class="h-48 overflow-hidden">
                <Image
                    src={talkshow}
                    alt="Blabla SINGA"
                    width={400}
                    height={250}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
            </div>
            <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-lg font-bold text-obt-dark mb-2">
                    🤝 Singa Blabla (Mardis)
                </h3>
                <p class="text-obt-muted text-sm leading-relaxed">
                    Un espace convivial pour pratiquer le français, discuter,
                    jouer et créer du lien dans la joie.
                </p>
            </div>
        </div>

        <div
            class="group rounded-2xl overflow-hidden bg-obt-light border border-obt-muted/10 shadow-sm flex flex-col"
        >
            <div class="h-48 overflow-hidden">
                <Image
                    src={danse}
                    alt="Cours de danse"
                    width={400}
                    height={250}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
            </div>
            <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-lg font-bold text-obt-dark mb-2">
                    💃 Cours de danse (Vendredis)
                </h3>
                <p class="text-obt-muted text-sm leading-relaxed">
                    Salsa, bachata... Des ateliers accessibles à tous les
                    niveaux pour s'exprimer en musique.
                </p>
            </div>
        </div>

        <div
            class="group rounded-2xl overflow-hidden bg-obt-light border border-obt-muted/10 shadow-sm flex flex-col"
        >
            <div class="h-48 overflow-hidden">
                <Image
                    src={scene}
                    alt="Soirées musicales"
                    width={400}
                    height={250}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
            </div>
            <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-lg font-bold text-obt-dark mb-2">
                    🎶 Soirées & Karaoké (Mensuel)
                </h3>
                <p class="text-obt-muted text-sm leading-relaxed">
                    Concerts, scènes ouvertes et soirées karaoké international
                    le premier vendredi du mois !
                </p>
            </div>
        </div>
    </div>

    <div class="text-center mt-12">
        <a
            href="/evenements"
            class="inline-block px-8 py-3 rounded-full bg-obt-secondary text-white font-medium hover:bg-obt-secondary/90 transition-all shadow"
        >
            Voir toute la programmation →
        </a>
    </div>
</section>
