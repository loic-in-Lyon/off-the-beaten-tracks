---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import EventCard from "../../components/EventCard.astro";

// Import du visuel depuis assets/images/
import talkshowImg from "../../assets/images/talkshow.webp";

const allEvents = await getCollection("events");
const now = new Date();

// 1. Événements récurrents / Rendez-vous réguliers
const recurringEvents = allEvents.filter((e) => e.data.isRecurring);

// 2. Événements ponctuels à venir (tri chronologique)
const upcomingEvents = allEvents
    .filter((e) => !e.data.isRecurring && new Date(e.data.date) >= now)
    .sort(
        (a, b) =>
            new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
    );

// 3. Événements ponctuels passés (tri antéchronologique)
const pastEvents = allEvents
    .filter((e) => !e.data.isRecurring && new Date(e.data.date) < now)
    .sort(
        (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    );
---

<Layout
    title="Agenda & Événements - OBT Café Lyon"
    description="Découvrez la programmation culturelle, les concerts, cours de danse et ateliers de l'OBT Café (Lyon 3e)."
>
    <!-- Fil d'Ariane -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-light/80 py-3 border-b border-obt-muted/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a
                        href="/"
                        class="hover:text-[var(--color-event-text)] font-medium transition-colors"
                        >Accueil</a
                    >
                </li>
                <li>
                    <span class="text-obt-muted/40 px-2">/</span>
                    <span
                        class="text-obt-dark font-semibold"
                        aria-current="page">Événements</span
                    >
                </li>
            </ol>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="py-12 md:py-16 bg-[var(--color-event-light)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7 space-y-4 text-center lg:text-left">
                    <span
                        class="inline-block px-3.5 py-1.5 rounded-full bg-[var(--color-event)]/25 text-[var(--color-event-text)] font-bold text-xs tracking-wider uppercase border border-[var(--color-event)]/30"
                    >
                        La vie du tiers-lieu
                    </span>
                    <h1
                        class="text-3xl sm:text-5xl font-extrabold text-obt-dark font-serif"
                    >
                        Notre Agenda
                    </h1>
                    <p
                        class="text-base sm:text-lg text-obt-muted max-w-2xl mx-auto lg:mx-0"
                    >
                        Concerts, ateliers récurrents, cours de danse et
                        rencontres interculturelles : rejoignez-nous au 236
                        Cours Lafayette.
                    </p>
                </div>

                <div class="lg:col-span-5 hidden sm:flex justify-center">
                    <div
                        class="relative rounded-3xl overflow-hidden border border-[var(--color-event)]/30 shadow-sm max-h-56 w-full"
                    >
                        <Image
                            src={talkshowImg}
                            alt="Événements et rencontres au café"
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Événements Ponctuels à Venir -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
            <div class="border-l-4 border-[var(--color-event)] pl-4">
                <h2
                    class="text-2xl sm:text-3xl font-bold text-obt-dark font-serif"
                >
                    Événements à venir
                </h2>
                <p class="text-sm text-obt-muted mt-1">
                    Les prochains rendez-vous ponctuels et dates uniques à ne
                    pas manquer.
                </p>
            </div>

            {
                upcomingEvents.length === 0 ? (
                    <div class="bg-[var(--color-event-light)] rounded-2xl p-8 text-center border border-[var(--color-event)]/20 space-y-2">
                        <p class="text-[var(--color-event-text)] font-semibold">
                            Aucun événement ponctuel n'est actuellement
                            programmé.
                        </p>
                        <p class="text-sm text-obt-muted">
                            Retrouvez nos ateliers réguliers ci-dessous ou
                            suivez-nous sur nos réseaux !
                        </p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {upcomingEvents.map((event) => (
                            <EventCard event={event} />
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <!-- Rendez-vous & Ateliers Récurrents -->
    {
        recurringEvents.length > 0 && (
            <section class="py-16 bg-[var(--color-event-light)]/40 border-t border-[var(--color-event)]/20">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
                    <div class="border-l-4 border-[var(--color-event)] pl-4">
                        <h2 class="text-2xl sm:text-3xl font-bold text-obt-dark font-serif">
                            Rendez-vous réguliers & Ateliers
                        </h2>
                        <p class="text-sm text-obt-muted mt-1">
                            Nos activités de groupe hebdomadaires et mensuelles
                            tout au long de l'année.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {recurringEvents.map((event) => (
                            <EventCard event={event} />
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <!-- Événements Passés -->
    {
        pastEvents.length > 0 && (
            <section class="py-16 bg-obt-light/40 border-t border-obt-muted/10">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
                    <h2 class="text-2xl sm:text-3xl font-bold text-obt-dark border-l-4 border-obt-muted pl-4 font-serif">
                        Événements passés
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {pastEvents.map((event) => (
                            <EventCard event={event} isPast={true} />
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <!-- Call To Action -->
    <section class="py-14 bg-white border-t border-obt-muted/10 text-center">
        <div class="max-w-3xl mx-auto px-4 space-y-4">
            <h3 class="text-xl sm:text-2xl font-bold text-obt-dark font-serif">
                Vous souhaitez animer un atelier ou proposer un concert ?
            </h3>
            <p class="text-sm text-obt-muted max-w-xl mx-auto leading-relaxed">
                L'OBT Café est un espace participatif ouvert aux initiatives
                citoyennes, culturelles et artistiques.
            </p>
            <div class="pt-2">
                <a
                    href="/contact"
                    class="inline-block px-6 py-3 rounded-full bg-[var(--color-event)] text-[var(--color-event-text)] font-extrabold text-xs hover:brightness-95 transition-all shadow-sm uppercase tracking-wider"
                >
                    Proposer un événement / Nous contacter
                </a>
            </div>
        </div>
    </section>
</Layout>
