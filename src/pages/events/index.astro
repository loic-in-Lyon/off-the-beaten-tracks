---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import EventCard from "../../components/EventCard.astro";

const allEvents = await getCollection("events");
const now = new Date();

// Prochains événements (tri chronologique)
const upcomingEvents = allEvents
    .filter((e) => new Date(e.data.date) >= now)
    .sort(
        (a, b) =>
            new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
    );

// Événements passés (tri antéchronologique)
const pastEvents = allEvents
    .filter((e) => new Date(e.data.date) < now)
    .sort(
        (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    );
---

<Layout
    title="Agenda & Événements - OBT Café Lyon"
    description="Découvrez la programmation culturelle, les concerts, cours de danse et ateliers de l'OBT Café (Lyon 3e)."
>
    <Header slot="header" />

    <!-- Fil d'Ariane -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-secondary/5 py-3 border-b border-obt-secondary/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="/" class="hover:text-obt-primary transition-colors"
                        >Accueil</a>
                </li>
                <li>
                    <span class="text-obt-muted/40 px-2">/</span><span
                        class="text-obt-dark font-medium"
                        aria-current="page">Événements</span>
                </li>
            </ol>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="py-16 bg-obt-light text-center">
        <div class="max-w-4xl mx-auto px-4 space-y-4">
            <span
                class="inline-block px-3.5 py-1.5 rounded-full bg-obt-primary/10 text-obt-primary font-semibold text-xs tracking-wide uppercase"
            >
                La vie du tiers-lieu
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-obt-dark">
                Notre Agenda
            </h1>
            <p class="text-lg text-obt-muted max-w-2xl mx-auto">
                Concerts, ateliers récurrents, cours de danse et rencontres
                interculturelles : rejoignez-nous au 236 Cours Lafayette.
            </p>
        </div>
    </section>

    <!-- Prochains Événements -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
            <h2
                class="text-2xl sm:text-3xl font-bold text-obt-dark border-l-4 border-obt-primary pl-4"
            >
                Événements & ateliers à venir
            </h2>

            {
                upcomingEvents.length === 0 ? (
                    <p class="text-obt-muted italic py-8">
                        Aucun événement n'est actuellement programmé. Revenez
                        très vite !
                    </p>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {upcomingEvents.map((event) => (
                            <EventCard event={event} />
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <!-- Événements Passés -->
    {
        pastEvents.length > 0 && (
            <section class="py-16 bg-obt-light/50 border-t border-obt-muted/10">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
                    <h2 class="text-2xl sm:text-3xl font-bold text-obt-dark border-l-4 border-obt-muted pl-4">
                        Événements passés
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {pastEvents.map((event) => (
                            <EventCard event={event} isPast={true} />
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <Footer slot="footer" />
</Layout>
