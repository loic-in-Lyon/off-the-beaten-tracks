---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// Importation des assets visuels
import salleObt from "../assets/images/salle-obt.webp";
import talkshow from "../assets/images/talkshow.webp";
import conference from "../assets/images/conference.webp";

// Données structurées JSON-LD pour le Geo-SEO (LocalBusiness / CafeOrCoffeeShop)
const localBusinessJsonLd = {
    "@context": "https://schema.org",
    "@type": "CafeOrCoffeeShop",
    name: "OBT Café",
    image: "https://offthebeatentracks.fr/images/salle-obt.webp",
    "@id": "https://offthebeatentracks.fr/le-cafe",
    url: "https://offthebeatentracks.fr/le-cafe",
    telephone: "",
    email: "contact.obtlyon@gmail.com",
    address: {
        "@type": "PostalAddress",
        streetAddress: "236 Cours Lafayette, Maison de l'Hospitalité",
        addressLocality: "Lyon",
        postalCode: "69003",
        addressCountry: "FR",
    },
    geo: {
        "@type": "GeoCoordinates",
        latitude: 45.7605,
        longitude: 4.8516,
    },
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Tuesday", "Wednesday"],
            opens: "13:00",
            closes: "18:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Thursday", "Friday"],
            opens: "13:00",
            closes: "20:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Saturday"],
            opens: "14:00",
            closes: "20:00",
        },
    ],
    priceRange: "€",
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: "https://offthebeatentracks.fr",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Le Café",
            item: "https://offthebeatentracks.fr/le-cafe",
        },
    ],
};
---

<Layout
    title="L'OBT Café - Tiers-lieu & Espace Solidaire à Lyon 3e"
    description="Découvrez l'OBT Café au 236 cours Lafayette à Lyon : un espace café-bar-bibliothèque interculturel, lieu de rencontre, d'échanges et de location de salle."
>
    <!-- Balises Schema.org pour le SEO Local et l'IA -->
    <script
        type="application/ld+json"
        set:html={JSON.stringify(localBusinessJsonLd)}
        slot="head"
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbJsonLd)}
        slot="head"
    />

    <Header slot="header" />

    <!-- Fil d'Ariane -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-secondary/5 py-3 border-b border-obt-secondary/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="/" class="hover:text-obt-primary transition-colors"
                        >Accueil</a
                    >
                </li>
                <li class="flex items-center space-x-2">
                    <span class="text-obt-muted/40">/</span>
                    <span class="text-obt-dark font-medium" aria-current="page"
                        >Le Café</span
                    >
                </li>
            </ol>
        </div>
    </nav>

    <!-- Hero Section Le Café -->
    <section class="py-16 md:py-24 bg-obt-light">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-6">
                <span
                    class="inline-block px-3.5 py-1.5 rounded-full bg-obt-primary/10 text-obt-primary font-semibold text-xs tracking-wide uppercase"
                >
                    Maison de l'Hospitalité • Lyon 3e
                </span>
                <h1
                    class="text-4xl sm:text-5xl font-extrabold tracking-tight text-obt-dark leading-tight"
                >
                    Un espace de vie, de café et de <span
                        class="text-obt-primary">partage</span
                    >
                </h1>
                <p class="text-lg text-obt-muted leading-relaxed">
                    Ouvert en avril 2025, l'<strong>OBT Café</strong> est un lieu
                    associatif et interculturel pensé comme un espace de rencontre
                    ouvert aux habitants du quartier et à l’ensemble des citoyens.
                </p>
                <div class="flex flex-wrap gap-4 pt-2">
                    <a
                        href="#infos-pratiques"
                        class="px-6 py-3 rounded-full bg-obt-primary text-white font-medium hover:bg-obt-primary/90 transition-all shadow-md"
                    >
                        Horaires & Accès
                    </a>
                    <a
                        href="#location-salle"
                        class="px-6 py-3 rounded-full border-2 border-obt-secondary text-obt-secondary font-medium hover:bg-obt-secondary hover:text-white transition-all"
                    >
                        Location de salle
                    </a>
                </div>
            </div>
            <div
                class="rounded-3xl overflow-hidden shadow-xl border border-obt-muted/20"
            >
                <Image
                    src={salleObt}
                    alt="Vue d'ensemble de la salle de l'OBT Café"
                    width={800}
                    height={533}
                    class="w-full h-auto object-cover"
                    loading="eager"
                />
            </div>
        </div>
    </section>

    <!-- Section Description du Projet & Concept -->
    <section class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
            <div class="space-y-6 text-center">
                <h2 class="text-3xl font-bold text-obt-dark">
                    Un tiers-lieu au cœur de la cohésion sociale
                </h2>
                <p class="text-obt-muted leading-relaxed text-base sm:text-lg">
                    Articulé autour d’un <strong
                        >espace café-bar-bibliothèque</strong
                    >, le lieu favorise les échanges, le travail collaboratif et
                    l’accès à l’information, notamment sur les droits et les
                    services disponibles sur le territoire.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
                <div
                    class="bg-obt-light p-8 rounded-3xl border border-obt-muted/10 space-y-4"
                >
                    <div
                        class="w-12 h-12 rounded-xl bg-obt-primary/10 flex items-center justify-center text-2xl"
                    >
                        ☕
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark">
                        Café & Bibliothèque
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Un espace chaleureux pour boire un verre, se détendre,
                        bouquiner ou discuter avec les bénévoles et les
                        visiteurs de tous horizons.
                    </p>
                </div>

                <div
                    class="bg-obt-light p-8 rounded-3xl border border-obt-muted/10 space-y-4"
                >
                    <div
                        class="w-12 h-12 rounded-xl bg-obt-secondary/10 flex items-center justify-center text-2xl"
                    >
                        🤝
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark">
                        Dynamique partenariale
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Nous mobilisons un réseau de partenaires locaux
                        (associations, centres sociaux, médiathèques) pour
                        co-construire et animer des activités inclusives.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section Infos Pratiques & Horaires -->
    <section id="infos-pratiques" class="py-20 bg-obt-dark text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
            <span
                class="text-obt-accent font-bold text-sm tracking-wider uppercase"
                >INFORMATIONS PRATIQUES</span
            >
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-2">
                📍 Venir à l'OBT Café
            </h2>
        </div>

        <div
            class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8"
        >
            <!-- Bloc Adresse & Contact -->
            <div
                class="bg-white/5 p-8 rounded-3xl border border-white/10 backdrop-blur space-y-6"
            >
                <div>
                    <h3 class="text-xl font-bold text-obt-accent mb-2">
                        Adresse exacte
                    </h3>
                    <p class="text-obt-muted leading-relaxed">
                        <strong>OBT Café</strong><br />
                        Maison de l’Hospitalité<br />
                        236 cours Lafayette<br />
                        69003 Lyon
                    </p>
                </div>
                <div class="pt-4 border-t border-white/10">
                    <h3 class="text-xl font-bold text-obt-accent mb-2">
                        Contact direct
                    </h3>
                    <p class="text-obt-muted text-sm">
                        Mail : <a
                            href="mailto:contact.obtlyon@gmail.com"
                            class="text-white underline hover:text-obt-accent"
                            >contact.obtlyon@gmail.com</a
                        >
                    </p>
                </div>
            </div>

            <!-- Bloc Horaires -->
            <div
                class="bg-white/5 p-8 rounded-3xl border border-white/10 backdrop-blur space-y-6"
            >
                <div>
                    <h3 class="text-xl font-bold text-obt-accent mb-2">
                        Horaires d'ouverture
                    </h3>
                    <ul class="text-obt-muted space-y-2 text-sm sm:text-base">
                        <li
                            class="flex justify-between border-b border-white/5 pb-2"
                        >
                            <span>Mardi & Mercredi :</span>
                            <span class="font-semibold text-white"
                                >13h00 – 18h00</span
                            >
                        </li>
                        <li
                            class="flex justify-between border-b border-white/5 pb-2"
                        >
                            <span>Jeudi & Vendredi :</span>
                            <span class="font-semibold text-white"
                                >13h00 – 20h00</span
                            >
                        </li>
                        <li class="flex justify-between pb-2">
                            <span>Samedi :</span>
                            <span class="font-semibold text-white"
                                >14h00 – 20h00</span
                            >
                        </li>
                    </ul>
                </div>
                <p class="text-xs text-obt-accent/90 italic">
                    * Attention : les horaires peuvent être modifiés ou élargis
                    lors d'événements programmés en soirée !
                </p>
            </div>
        </div>
    </section>

    <!-- Section Location de Salle -->
    <section id="location-salle" class="py-20 bg-white">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-6">
                <span
                    class="text-obt-primary font-bold text-sm tracking-wider uppercase"
                    >PRIVATISATION & SERVICES</span
                >
                <h2
                    class="text-3xl sm:text-4xl font-extrabold text-obt-dark tracking-tight"
                >
                    Vous souhaitez louer la salle ?
                </h2>
                <p class="text-obt-muted leading-relaxed">
                    Vous souhaitez organiser une réunion, une formation, un
                    atelier ou un événement professionnel/associatif à l’OBT
                    Café au sein de la Maison de l’Hospitalité ? Notre espace
                    modulable s'adapte à vos besoins.
                </p>
                <p class="text-obt-muted leading-relaxed text-sm">
                    Pour en savoir plus sur nos conditions, nos disponibilités
                    et nos tarifs, écrivez-nous directement par e-mail.
                </p>
                <div>
                    <a
                        href="/contact"
                        class="inline-block px-8 py-3 rounded-full bg-obt-secondary text-white font-medium hover:bg-obt-secondary/90 transition-all shadow"
                    >
                        Nous contacter pour une location →
                    </a>
                </div>
            </div>
            <div
                class="rounded-3xl overflow-hidden shadow-lg border border-obt-muted/10"
            >
                <Image
                    src={conference}
                    alt="Événement et configuration de la salle OBT Café"
                    width={700}
                    height={450}
                    class="w-full h-auto object-cover"
                />
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</Layout>
