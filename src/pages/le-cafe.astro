---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

import salleObt from "../assets/images/salle-obt.webp";
import conference from "../assets/images/conference.webp";

const localBusinessJsonLd = {
    "@context": "https://schema.org",
    "@type": "CafeOrCoffeeShop",
    name: "OBT Café",
    image: "https://offthebeatentracks.fr/images/salle-obt.webp",
    "@id": "https://offthebeatentracks.fr/le-cafe",
    url: "https://offthebeatentracks.fr/le-cafe",
    telephone: "",
    email: "contact.obtlyon@gmail.com",
    address: {
        "@type": "PostalAddress",
        streetAddress: "236 Cours Lafayette, Maison de l'Hospitalité",
        addressLocality: "Lyon",
        postalCode: "69003",
        addressCountry: "FR",
    },
    geo: {
        "@type": "GeoCoordinates",
        latitude: 45.7605,
        longitude: 4.8516,
    },
    openingHoursSpecification: [
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Tuesday", "Wednesday"],
            opens: "13:00",
            closes: "18:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Thursday", "Friday"],
            opens: "13:00",
            closes: "20:00",
        },
        {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Saturday"],
            opens: "14:00",
            closes: "20:00",
        },
    ],
    priceRange: "€",
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: "https://offthebeatentracks.fr",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Le Café",
            item: "https://offthebeatentracks.fr/le-cafe",
        },
    ],
};
---

<Layout
    title="L'OBT Café - Tiers-lieu & Espace Solidaire à Lyon 3e"
    description="Découvrez l'OBT Café au 236 cours Lafayette à Lyon : un espace café-bar-bibliothèque interculturel, lieu de rencontre, d'échanges et de location de salle."
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(localBusinessJsonLd)}
        slot="head"
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbJsonLd)}
        slot="head"
    />

    <!-- Fil d'Ariane -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-light/80 py-3 border-b border-obt-muted/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="/" class="hover:text-cafe-text transition-colors"
                        >Accueil</a
                    >
                </li>
                <li class="flex items-center space-x-2">
                    <span class="text-obt-muted/40">/</span>
                    <span class="text-cafe-text font-bold" aria-current="page"
                        >Le Café</span
                    >
                </li>
            </ol>
        </div>
    </nav>

    <!-- Hero Section Le Café -->
    <section class="py-12 md:py-20 bg-cafe-light border-b border-cafe/20">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-6">
                <span
                    class="inline-block px-4 py-1.5 rounded-full bg-cafe-text text-white font-extrabold text-xs tracking-wider uppercase shadow-sm"
                >
                    ☕ Maison de l'Hospitalité • Lyon 3e
                </span>
                <h1
                    class="text-4xl sm:text-5xl font-extrabold tracking-tight text-obt-dark leading-tight font-serif"
                >
                    Un espace de vie, de café et de <span class="text-cafe-text"
                        >partage</span
                    >
                </h1>
                <p class="text-lg text-obt-muted leading-relaxed">
                    Ouvert en avril 2025, l'<strong>OBT Café</strong> est un lieu
                    associatif et interculturel pensé comme un espace de rencontre
                    ouvert aux habitants du quartier et à l’ensemble des citoyens.
                </p>
                <div class="flex flex-wrap gap-4 pt-2">
                    <a
                        href="#infos-pratiques"
                        class="px-6 py-3 rounded-full bg-cafe-text text-white font-bold text-xs hover:opacity-90 transition-all shadow-sm"
                    >
                        Horaires & Accès
                    </a>
                    <a
                        href="#location-salle"
                        class="px-6 py-3 rounded-full bg-white text-cafe-text font-bold text-xs hover:bg-white/80 transition-all border border-cafe/30"
                    >
                        Location de salle
                    </a>
                </div>
            </div>
            <div
                class="rounded-3xl overflow-hidden shadow-sm border border-cafe/20"
            >
                <Image
                    src={salleObt}
                    alt="Vue d'ensemble de la salle de l'OBT Café"
                    width={800}
                    height={533}
                    class="w-full h-auto object-cover"
                    loading="eager"
                />
            </div>
        </div>
    </section>

    <!-- Section Description -->
    <section class="py-20 bg-white border-y border-obt-border">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
            <div class="space-y-6 text-center">
                <h2 class="text-3xl font-bold text-obt-dark font-serif">
                    Un tiers-lieu au cœur de la cohésion sociale
                </h2>
                <p class="text-obt-muted leading-relaxed text-base sm:text-lg">
                    Articulé autour d’un <strong
                        class="text-cafe-text font-bold"
                        >espace café-bar-bibliothèque</strong
                    >, le lieu favorise les échanges, le travail collaboratif et
                    l’accès à l’information, notamment sur les droits et les
                    services disponibles sur le territoire.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6">
                <div
                    class="bg-cafe-light/40 p-8 rounded-3xl border border-cafe/20 space-y-4 shadow-[0_4px_20px_rgba(0,0,0,0.02)]"
                >
                    <div
                        class="w-12 h-12 rounded-2xl bg-cafe/20 flex items-center justify-center text-2xl"
                    >
                        ☕
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark font-serif">
                        Café & Bibliothèque
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Un espace chaleureux pour boire un verre, se détendre,
                        bouquiner ou discuter avec les bénévoles et les
                        visiteurs de tous horizons.
                    </p>
                </div>

                <div
                    class="bg-cafe-light/40 p-8 rounded-3xl border border-cafe/20 space-y-4 shadow-[0_4px_20px_rgba(0,0,0,0.02)]"
                >
                    <div
                        class="w-12 h-12 rounded-2xl bg-cafe/20 flex items-center justify-center text-2xl"
                    >
                        🤝
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark font-serif">
                        Dynamique partenariale
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Nous mobilisons un réseau de partenaires locaux pour
                        co-construire des activités inclusives. Découvrez notre <a
                            href="/association"
                            class="text-cafe-text underline font-semibold"
                            >projet associatif</a
                        >.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section Infos Pratiques (Remplacée par un style Pastel Lumineux Harmonieux) -->
    <section
        id="infos-pratiques"
        class="py-20 bg-cafe-light/30 border-b border-obt-border"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
            <span
                class="text-cafe-text font-bold text-xs tracking-widest uppercase bg-cafe-light px-4 py-1.5 rounded-full border border-cafe/20"
                >Informations pratiques & Géolocalisation</span
            >
            <h2
                class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-3 font-serif text-obt-dark"
            >
                📍 Venir à l'OBT Café
            </h2>
        </div>

        <div
            class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8"
        >
            <!-- Bloc Adresse & Contact -->
            <div
                class="bg-white p-8 rounded-3xl border border-cafe/25 shadow-[0_10px_30px_rgba(0,0,0,0.03)] space-y-6"
            >
                <div>
                    <h3
                        class="text-xl font-bold text-cafe-text mb-2 font-serif"
                    >
                        Adresse exacte
                    </h3>
                    <p class="text-obt-muted leading-relaxed text-sm">
                        <strong>OBT Café</strong><br />
                        Maison de l’Hospitalité<br />
                        236 cours Lafayette<br />
                        69003 Lyon (Part-Dieu / Dauphiné)
                    </p>
                </div>
                <div class="pt-4 border-t border-obt-border">
                    <h3
                        class="text-xl font-bold text-cafe-text mb-2 font-serif"
                    >
                        Contact direct
                    </h3>
                    <p class="text-obt-muted text-sm">
                        Écrivez-nous à : <a
                            href="mailto:contact.obtlyon@gmail.com"
                            class="text-cafe-text underline hover:opacity-80 font-semibold"
                            >contact.obtlyon@gmail.com</a
                        >
                    </p>
                </div>
            </div>

            <!-- Bloc Horaires -->
            <div
                class="bg-white p-8 rounded-3xl border border-cafe/25 shadow-[0_10px_30px_rgba(0,0,0,0.03)] space-y-6"
            >
                <div>
                    <h3
                        class="text-xl font-bold text-cafe-text mb-2 font-serif"
                    >
                        Horaires d'ouverture
                    </h3>
                    <ul class="text-obt-muted space-y-2 text-sm">
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Mardi & Mercredi :</span>
                            <span class="font-semibold text-obt-dark"
                                >13h00 – 18h00</span
                            >
                        </li>
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Jeudi & Vendredi :</span>
                            <span class="font-semibold text-obt-dark"
                                >13h00 – 20h00</span
                            >
                        </li>
                        <li class="flex justify-between pb-2">
                            <span>Samedi :</span>
                            <span class="font-semibold text-obt-dark"
                                >14h00 – 20h00</span
                            >
                        </li>
                    </ul>
                </div>
                <p class="text-xs text-cafe-text/80 italic">
                    * Exceptionnellement ouvert en soirée lors de nos <a
                        href="/events"
                        class="underline font-medium text-cafe-text"
                        >événements culturels</a
                    >.
                </p>
            </div>
        </div>
    </section>

    <!-- Section Location de Salle -->
    <section id="location-salle" class="py-20 bg-white">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-6">
                <span
                    class="inline-block px-4 py-1.5 rounded-full bg-cafe-light text-cafe-text font-bold text-xs tracking-wide uppercase border border-cafe/25"
                >
                    Privatisation & Services
                </span>
                <h2
                    class="text-3xl sm:text-4xl font-extrabold text-obt-dark tracking-tight font-serif"
                >
                    Vous souhaitez louer la salle ?
                </h2>
                <p class="text-obt-muted leading-relaxed">
                    Vous souhaitez organiser une réunion, une formation, un
                    atelier ou un événement professionnel/associatif à l’OBT
                    Café au sein de la Maison de l’Hospitalité ? Notre espace
                    modulable s'adapte à vos besoins.
                </p>
                <div>
                    <a
                        href="/location-salle"
                        class="inline-block px-8 py-3 rounded-full bg-cafe-text text-white font-semibold text-xs hover:opacity-95 transition-all shadow-[0_4px_14px_rgba(130,50,24,0.2)]"
                    >
                        Louer le café →
                    </a>
                </div>
            </div>
            <div
                class="rounded-3xl overflow-hidden shadow-[0_12px_32px_rgba(0,0,0,0.06)] border border-obt-border"
            >
                <Image
                    src={conference}
                    alt="Événement et configuration de la salle OBT Café"
                    width={700}
                    height={450}
                    class="w-full h-auto object-cover"
                />
            </div>
        </div>
    </section>
</Layout>
