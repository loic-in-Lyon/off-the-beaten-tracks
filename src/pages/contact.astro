---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
    title="Contact & Accès - OBT Café Lyon"
    description="Contactez l'équipe d'Off The Beaten Tracks à Lyon 3e : demandes d'information, privatisation de salle, propositions artistiques ou bénévolat."
>
    <section class="py-16 bg-obt-light border-b border-obt-muted/10">
        <div class="max-w-4xl mx-auto px-4 text-center space-y-4">
            <span
                class="inline-block px-3.5 py-1.5 rounded-full bg-obt-primary/10 text-obt-primary font-semibold text-xs tracking-wide uppercase"
            >
                Échangeons ensemble
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-obt-dark">
                Contactez-nous
            </h1>
            <p class="text-lg text-obt-muted max-w-2xl mx-auto">
                Une question sur nos activités, envie de privatiser notre salle
                ou d'animer un atelier ? Envoyez-nous un message !
            </p>
        </div>
    </section>

    <section class="py-16 bg-white">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12"
        >
            <!-- Infos pratiques à gauche -->
            <div class="lg:col-span-5 space-y-8">
                <div>
                    <h2 class="text-2xl font-bold text-obt-dark mb-4">
                        OBT Café
                    </h2>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Un tiers-lieu culturel, convivial et solidaire géré par
                        l'association Off The Beaten Tracks.
                    </p>
                </div>

                <div class="space-y-4 text-sm text-obt-dark">
                    <div class="flex items-start gap-3">
                        <span class="text-xl">📍</span>
                        <div>
                            <strong>Adresse :</strong><br />
                            236 Cours Lafayette, 69003 Lyon
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="text-xl">🚌</span>
                        <div>
                            <strong>Accès :</strong><br />
                            Bus C3 / C13 — Arrêt Part-Dieu Jules Favre
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <span class="text-xl">✉️</span>
                        <div>
                            <strong>Email :</strong><br />
                            <a
                                href="mailto:contact@offthebeatentracks.fr"
                                class="text-obt-primary hover:underline"
                            >
                                contact@offthebeatentracks.fr
                            </a>
                        </div>
                    </div>
                </div>

                <div
                    class="p-6 bg-obt-light rounded-2xl border border-obt-muted/15 space-y-2"
                >
                    <h3 class="font-bold text-obt-dark text-sm">
                        Horaires d'ouverture
                    </h3>
                    <p class="text-xs text-obt-muted leading-relaxed">
                        Variables selon la programmation culturelle et les
                        ateliers. Consultez notre agenda pour connaître les
                        prochains rendez-vous !
                    </p>
                </div>
            </div>

            <!-- Formulaire Web3Forms à droite -->
            <div class="lg:col-span-7">
                <ContactForm />
            </div>
        </div>
    </section>
</Layout>
