---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
    title="Contact & Accès - OBT Café Lyon"
    description="Contactez l'équipe d'Off The Beaten Tracks à Lyon 3e : demandes d'information, privatisation de salle, propositions artistiques ou bénévolat."
>
    <!-- En-tête avec rappel de couleur Bleu Canard (similaire au blog) -->
    <section
        class="bg-[var(--color-action-light)]/40 border-b border-obt-muted/10 py-12"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
            <!-- Fil d'ariane -->
            <nav
                class="text-xs font-medium text-obt-muted flex items-center gap-2"
            >
                <a href="/" class="hover:text-obt-dark transition-colors"
                    >Accueil</a
                >
                <span>/</span>
                <span class="text-obt-dark font-bold">Contact</span>
            </nav>

            <!-- Titre & Hero -->
            <div class="text-center max-w-2xl mx-auto space-y-3">
                <span
                    class="inline-block px-3.5 py-1 rounded-full bg-action/10 text-action font-bold text-xs uppercase tracking-wider border border-action/20"
                >
                    Échangeons ensemble
                </span>
                <h1
                    class="text-3xl sm:text-5xl font-extrabold text-obt-dark font-serif tracking-tight"
                >
                    Contactez-nous
                </h1>
                <p class="text-obt-muted text-base leading-relaxed">
                    Une question sur nos activités, envie d'organiser un
                    événement ou de proposer un atelier ? Envoyez-nous un
                    message.
                </p>
            </div>
        </div>
    </section>

    <!-- Corps de page : Infos pratiques & Formulaire -->
    <section class="py-16 bg-obt-light">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div
                class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-6xl mx-auto"
            >
                <!-- Colonne Infos Pratiques (Gauche) -->
                <div
                    class="lg:col-span-5 space-y-8 bg-white p-8 sm:p-10 rounded-3xl border border-obt-muted/15 shadow-sm"
                >
                    <div>
                        <h2
                            class="text-2xl font-serif font-bold text-obt-dark mb-2"
                        >
                            L'association & Le Tiers-Lieu
                        </h2>
                        <p class="text-obt-muted text-sm leading-relaxed">
                            Un espace culturel, solidaire et citoyen géré par
                            l'association Off The Beaten Tracks au cœur de Lyon.
                        </p>
                    </div>

                    <div
                        class="space-y-6 text-sm text-obt-dark border-t border-b border-obt-muted/10 py-6"
                    >
                        <!-- Adresse -->
                        <div class="flex items-start gap-4">
                            <div
                                class="w-10 h-10 rounded-xl bg-action/10 text-action flex items-center justify-center shrink-0 border border-action/20"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <strong class="font-bold block text-obt-dark"
                                    >Adresse</strong
                                >
                                <span
                                    class="text-obt-muted text-xs leading-relaxed block mt-0.5"
                                >
                                    OBT Café — Maison de l'Hospitalité<br />
                                    236 Cours Lafayette, 69003 Lyon
                                </span>
                            </div>
                        </div>

                        <!-- Accès -->
                        <div class="flex items-start gap-4">
                            <div
                                class="w-10 h-10 rounded-xl bg-action/10 text-action flex items-center justify-center shrink-0 border border-action/20"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <strong class="font-bold block text-obt-dark"
                                    >Accès transports</strong
                                >
                                <span
                                    class="text-obt-muted text-xs leading-relaxed block mt-0.5"
                                >
                                    Bus C3, C9, C13 (Arrêt Part-Dieu Jules Favre
                                    / Institut Contemporain)
                                </span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="flex items-start gap-4">
                            <div
                                class="w-10 h-10 rounded-xl bg-action/10 text-action flex items-center justify-center shrink-0 border border-action/20"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <strong class="font-bold block text-obt-dark"
                                    >E-mail direct</strong
                                >
                                <a
                                    href="mailto:contact@offthebeatentracks.fr"
                                    class="text-action text-xs font-semibold hover:underline block mt-0.5"
                                >
                                    contact@offthebeatentracks.fr
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Note Horaires -->
                    <div
                        class="p-5 bg-obt-light rounded-2xl border border-obt-muted/10 space-y-1"
                    >
                        <h3
                            class="font-bold text-obt-dark text-xs uppercase tracking-wider"
                        >
                            Horaires du Café & Permanences
                        </h3>
                        <p class="text-xs text-obt-muted leading-relaxed">
                            Variables selon la programmation et les ateliers.
                            Consultez notre agenda pour ne rien rater des
                            prochains rendez-vous !
                        </p>
                    </div>
                </div>

                <!-- Colonne Formulaire (Droite) -->
                <div class="lg:col-span-7">
                    <ContactForm />
                </div>
            </div>
        </div>
    </section>
</Layout>
