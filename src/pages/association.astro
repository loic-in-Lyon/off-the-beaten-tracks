---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// Importation d'une image d'illustration ou de la salle
import salleObt from "../assets/images/salle-obt.webp";
import illustrationEnsemble from "../assets/images/illustration-ensemble.png";

// Données structurées JSON-LD (SEO & IA Crawling)
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "NGO",
    name: "Off The Beaten Tracks",
    alternateName: "OBT",
    url: "https://offthebeatentracks.fr",
    logo: "https://offthebeatentracks.fr/favicon.svg",
    description:
        "Association fondée en 2022 à Lyon proposant un regard interculturel, l'inclusion et l'animation de l'OBT Café à la Maison de l'Hospitalité.",
    address: {
        "@type": "PostalAddress",
        streetAddress: "236 Cours Lafayette",
        addressLocality: "Lyon",
        postalCode: "69003",
        addressCountry: "FR",
    },
    sameAs: [
        "https://www.instagram.com/offthebeatentracks69",
        "https://www.facebook.com/share/1AvtdFzeJW/",
    ],
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: "https://offthebeatentracks.fr",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "L'Association",
            item: "https://offthebeatentracks.fr/association",
        },
    ],
};
---

<Layout
    title="L'Association & Notre Histoire - Off The Beaten Tracks (Lyon)"
    description="Découvrez l'association Off The Beaten Tracks fondée en 2022 à Lyon, sa mission interculturelle, son équipe et son engagement à la Maison de l'Hospitalité (OBT Café)."
>
    <!-- Injection des schémas JSON-LD pour le SEO -->
    <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
        slot="head"
    />
    <script
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbJsonLd)}
        slot="head"
    />

    <Header slot="header" />

    <!-- Fil d'Ariane SEO -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-secondary/5 py-3 border-b border-obt-secondary/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="/" class="hover:text-obt-primary transition-colors"
                        >Accueil</a
                    >
                </li>
                <li class="flex items-center space-x-2">
                    <span class="text-obt-muted/40">/</span>
                    <span class="text-obt-dark font-medium" aria-current="page"
                        >L'Association</span
                    >
                </li>
            </ol>
        </div>
    </nav>

    <!-- Hero de la page Association -->
    <section class="py-16 md:py-24 bg-obt-light">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-6">
                <span
                    class="inline-block px-3.5 py-1.5 rounded-full bg-obt-primary/10 text-obt-primary font-semibold text-xs tracking-wide uppercase"
                >
                    Notre Mission & Nos Racines
                </span>
                <h1
                    class="text-4xl sm:text-5xl font-extrabold tracking-tight text-obt-dark leading-tight"
                >
                    Un autre regard sur l'<span class="text-obt-primary"
                        >Humani'Terre</span
                    >
                </h1>
                <p class="text-lg text-obt-muted leading-relaxed">
                    Fondée en 2022 à Lyon, l'association <strong
                        >Off The Beaten Tracks (OBT)</strong
                    > propose un voyage aux confins du monde pour découvrir les trésors
                    culturels, sociétaux et environnementaux de pays méconnus.
                </p>
            </div>
            <div class="flex justify-center">
                <div
                    class="w-full max-w-md p-6 bg-white rounded-3xl shadow-sm border border-obt-muted/10"
                >
                    <Image
                        src={illustrationEnsemble}
                        alt="Illustration de la communauté Off The Beaten Tracks"
                        width={500}
                        height={400}
                        class="w-full h-auto object-contain"
                        loading="eager"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Section Histoire & Projet -->
    <section class="py-20 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
            <div class="space-y-6">
                <h2 class="text-3xl font-bold text-obt-dark">
                    Briser les stéréotypes, créer du lien
                </h2>
                <p class="text-obt-muted leading-relaxed text-base sm:text-lg">
                    Notre mission est de casser les images négatives que l’on
                    porte sur les publics exclus et marginalisés, et les
                    stéréotypes sujets parfois à discrimination (en particulier
                    envers les personnes migrantes). Nous y parvenons en
                    favorisant les rencontres directes, la compréhension des
                    facteurs d’isolement et la valorisation des exemples de
                    résilience portés par ces populations.
                </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-obt-light p-8 rounded-3xl border border-obt-muted/10"
            >
                <div class="space-y-4">
                    <span
                        class="text-obt-secondary font-bold text-xs uppercase tracking-wider"
                        >Le Tournant 2023 - 2025</span
                    >
                    <h3 class="text-2xl font-bold text-obt-dark">
                        L'aventure de la Maison de l’Hospitalité
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        En 2022, la Métropole de Lyon a annoncé la création de
                        la Maison de l’Hospitalité, destinée à accueillir des
                        associations œuvrant pour l’inclusion. OBT s’y est
                        associée en 2023 pour contribuer à l’animation du lieu.
                    </p>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Le café culturel a officiellement ouvert ses portes en <strong
                            >avril 2025</strong
                        > au <strong>236 cours Lafayette (Lyon 3e)</strong>,
                        offrant un espace accessible, chaleureux et convivial
                        favorisant le dialogue entre habitants et la cohésion
                        sociale.
                    </p>
                </div>
                <div class="rounded-2xl overflow-hidden shadow-md">
                    <Image
                        src={salleObt}
                        alt="Intérieur de l'OBT Café"
                        width={600}
                        height={400}
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Section L'Équipe -->
    <section class="py-20 bg-obt-light border-t border-obt-muted/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
            <span
                class="text-obt-primary font-bold text-sm tracking-wider uppercase"
                >LES VISAGES D'OBT</span
            >
            <h2
                class="text-3xl sm:text-4xl font-extrabold text-obt-dark tracking-tight mt-2"
            >
                Rencontrez l'équipe du café
            </h2>
            <p class="text-obt-muted max-w-2xl mx-auto mt-4">
                Depuis l'ouverture de l'OBT Café, l'équipe s'agrandit petit à
                petit pour faire vivre ce lieu unique au quotidien.
            </p>
        </div>

        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8"
        >
            <!-- Kévin -->
            <div
                class="bg-white p-8 rounded-3xl shadow-sm border border-obt-muted/10 space-y-4 flex flex-col justify-between"
            >
                <div>
                    <div
                        class="w-14 h-14 rounded-2xl bg-obt-primary/10 text-obt-primary flex items-center justify-center font-bold text-xl mb-4"
                    >
                        K
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark">Kévin</h3>
                    <p
                        class="text-xs font-semibold text-obt-primary uppercase tracking-wider mb-3"
                    >
                        Animateur de la Maison de l'Hospitalité
                    </p>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Il fait vivre le lieu et accueille, informe et oriente
                        le public au quotidien. Kévin est la personne que vous
                        verrez 99% du temps quand vous passez le pas de la porte
                        ! Il met en œuvre la programmation et reçoit vos
                        propositions de collaboration en direct.
                    </p>
                </div>
                <p
                    class="text-xs italic text-obt-muted/80 pt-4 border-t border-obt-muted/10"
                >
                    Besoin d’un renseignement, d’un conseil ou simplement de
                    bavarder ? C’est Kévin qu’il faudra trouver !
                </p>
            </div>

            <!-- Emilia -->
            <div
                class="bg-white p-8 rounded-3xl shadow-sm border border-obt-muted/10 space-y-4 flex flex-col justify-between"
            >
                <div>
                    <div
                        class="w-14 h-14 rounded-2xl bg-obt-secondary/10 text-obt-secondary flex items-center justify-center font-bold text-xl mb-4"
                    >
                        E
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark">Emilia</h3>
                    <p
                        class="text-xs font-semibold text-obt-secondary uppercase tracking-wider mb-3"
                    >
                        Cheffe de projet OBT
                    </p>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Elle pilote les projets, conçoit et structure la
                        programmation OBT, réalise le suivi du budget et des
                        indicateurs, et développe les partenariats stratégiques
                        de l'association.
                    </p>
                </div>
                <p
                    class="text-xs italic text-obt-muted/80 pt-4 border-t border-obt-muted/10"
                >
                    Emilia est souvent prête à sortir de sa tanière (son
                    bureau), il suffit de lui proposer une soirée karaoké et
                    c’est parti !
                </p>
            </div>

            <!-- Noah -->
            <div
                class="bg-white p-8 rounded-3xl shadow-sm border border-obt-muted/10 space-y-4 flex flex-col justify-between"
            >
                <div>
                    <div
                        class="w-14 h-14 rounded-2xl bg-obt-accent/20 text-obt-dark flex items-center justify-center font-bold text-xl mb-4"
                    >
                        N
                    </div>
                    <h3 class="text-xl font-bold text-obt-dark">Noah</h3>
                    <p
                        class="text-xs font-semibold text-obt-accent uppercase tracking-wider mb-3"
                    >
                        Volontaire en Service Civique
                    </p>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Pour compléter l'équipe au café, un·e volontaire assure
                        l'accueil chaleureux des visiteurs et l'animation active
                        des différents ateliers et temps forts.
                    </p>
                </div>
                <p
                    class="text-xs italic text-obt-muted/80 pt-4 border-t border-obt-muted/10"
                >
                    Un pilier dynamique de l'accueil et du partage au jour le
                    jour.
                </p>
            </div>
        </div>

        <!-- Encadré Bénévoles -->
        <div class="max-w-4xl mx-auto px-4 mt-12">
            <div
                class="bg-white p-8 rounded-3xl shadow-sm border border-obt-muted/10 text-center space-y-4"
            >
                <h3 class="text-2xl font-bold text-obt-dark">
                    👥 Et l'équipe bénévole !
                </h3>
                <p
                    class="text-obt-muted text-sm sm:text-base leading-relaxed max-w-2xl mx-auto"
                >
                    Une trentaine de bénévoles soutiennent l’action de l’OBT par
                    leur présence lors des événements et ateliers : accueil,
                    installation, médiation auprès des publics, ils participent
                    à la dynamique conviviale du lieu. C’est eux qui te
                    permettent de boire un verre pendant les soirées !
                </p>
                <div class="pt-2">
                    <a
                        href="/rejoindre"
                        class="inline-block px-6 py-2.5 rounded-full bg-obt-primary text-white font-medium text-sm hover:bg-obt-primary/90 transition-all shadow-sm"
                    >
                        Rejoindre les bénévoles →
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Maillage Interne / Call To Action Final -->
    <section class="py-16 bg-white border-t border-obt-muted/10 text-center">
        <div class="max-w-3xl mx-auto px-4 space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-obt-dark">
                Envie de découvrir le lieu en vrai ?
            </h2>
            <p class="text-obt-muted">
                Passez nous voir au 236 cours Lafayette ou jetez un œil à notre
                programmation et nos activités de la semaine.
            </p>
            <div class="flex flex-wrap justify-center gap-4 pt-2">
                <a
                    href="/le-cafe"
                    class="px-6 py-3 rounded-full bg-obt-secondary text-white font-medium hover:bg-obt-secondary/90 transition-all"
                >
                    Découvrir l'OBT Café
                </a>
                <a
                    href="/evenements"
                    class="px-6 py-3 rounded-full border-2 border-obt-secondary text-obt-secondary font-medium hover:bg-obt-secondary hover:text-white transition-all"
                >
                    Voir la programmation
                </a>
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</Layout>
