---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable (404) - OBT Café">
    <div class="min-h-[60vh] flex items-center justify-center py-16 px-4">
        <div class="text-center space-y-6 max-w-lg">
            <span class="text-6xl sm:text-8xl font-black text-obt-primary block"
                >404</span
            >
            <h1 class="text-2xl sm:text-4xl font-extrabold text-obt-dark">
                Oups ! Vous êtes hors des sentiers battus
            </h1>
            <p class="text-obt-muted text-base leading-relaxed">
                La page que vous recherchez n'existe pas ou a été déplacée.
            </p>
            <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="/"
                    class="px-6 py-3 rounded-full bg-obt-primary text-white font-bold hover:bg-obt-primary/90 transition-all text-sm"
                >
                    Retour à l'accueil
                </a>
                <a
                    href="/events"
                    class="px-6 py-3 rounded-full border border-obt-muted/30 text-obt-dark font-medium hover:bg-white transition-all text-sm"
                >
                    Voir l'agenda
                </a>
            </div>
        </div>
    </div>
</Layout>
