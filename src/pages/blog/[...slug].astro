---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.publishDate).toLocaleDateString(
    "fr-FR",
    {
        day: "numeric",
        month: "long",
        year: "numeric",
    },
);

// Sécurité pour l'image (Objet importé vs Texte/URL de Keystatic)
const isAstroImage = typeof post.data.image !== "string";
---

<Layout
    title={`${post.data.title} - Blog OBT Café`}
    description={post.data.description}
>
    <!-- Fil d'Ariane -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-light/80 py-3 border-b border-obt-muted/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a
                        href="/"
                        class="hover:text-[var(--color-blog-text)] font-medium transition-colors"
                        >Accueil</a
                    >
                </li>
                <li>
                    <span class="text-obt-muted/40 px-2">/</span>
                    <a
                        href="/blog"
                        class="hover:text-[var(--color-blog-text)] font-medium transition-colors"
                        >Blog</a
                    >
                </li>
                <li>
                    <span class="text-obt-muted/40 px-2">/</span>
                    <span
                        class="text-obt-dark font-semibold truncate max-w-[200px] sm:max-w-none inline-block align-bottom"
                        aria-current="page">{post.data.title}</span
                    >
                </li>
            </ol>
        </div>
    </nav>

    <main class="py-12 sm:py-16 bg-white">
        <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
            <!-- En-tête -->
            <div class="space-y-4 text-center">
                <span
                    class="inline-block px-3.5 py-1.5 rounded-full bg-[var(--color-blog)] text-[var(--color-blog-text)] font-extrabold text-xs tracking-wider uppercase shadow-sm"
                >
                    {post.data.category}
                </span>
                <h1
                    class="text-3xl sm:text-5xl font-extrabold text-obt-dark font-serif tracking-tight leading-tight"
                >
                    {post.data.title}
                </h1>
                <div
                    class="inline-flex items-center justify-center gap-3 px-4 py-2 rounded-full bg-[var(--color-blog-light)] text-[var(--color-blog-text)] text-xs sm:text-sm font-bold border border-[var(--color-blog)]/30"
                >
                    <span>✍️ {post.data.author}</span>
                    <span class="opacity-40">•</span>
                    <span>📅 {formattedDate}</span>
                </div>
            </div>

            <!-- Image à la une (si présente, avec gestion du type) -->
            {
                post.data.image && (
                    <div class="rounded-3xl overflow-hidden shadow-sm border border-obt-muted/15 bg-slate-50">
                        {isAstroImage ? (
                            <Image
                                src={post.data.image}
                                alt={post.data.title}
                                width={1000}
                                height={500}
                                class="w-full h-auto object-cover max-h-[450px]"
                            />
                        ) : (
                            <img
                                src={post.data.image}
                                alt={post.data.title}
                                class="w-full h-auto object-cover max-h-[450px]"
                            />
                        )}
                    </div>
                )
            }

            <!-- Chapeau / Description -->
            <p
                class="text-lg text-obt-dark font-medium leading-relaxed italic border-l-4 border-[var(--color-blog)] pl-4 py-1"
            >
                {post.data.description}
            </p>

            <!-- Contenu Markdown / Markdoc -->
            <div
                class="prose prose-lg max-w-none text-obt-muted space-y-4 leading-relaxed pt-4 border-t border-obt-muted/10"
            >
                <Content />
            </div>

            <!-- Retour au blog -->
            <div class="pt-12 border-t border-obt-muted/10 text-center">
                <a
                    href="/blog"
                    class="inline-block px-8 py-3 rounded-full border border-obt-muted/30 text-obt-dark font-bold hover:bg-[var(--color-blog-light)] hover:border-[var(--color-blog)] transition-all text-sm"
                >
                    ← Retour à tous les articles
                </a>
            </div>
        </article>
    </main>
</Layout>
