---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Values from "../components/Values.astro";
import CafeSection from "../components/CafeSection.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import LatestPosts from "../components/LatestPosts.astro";
import LocationCta from "../components/LocationCta.astro";
import GetInvolved from "../components/GetInvolved.astro";
---

<Layout
	title="Association Off The Beaten Tracks & OBT Café | Lyon 3e"
	description="Association culturelle et interculturelle à Lyon. Découvrez nos projets citoyens, l'OBT Café, notre programmation d'événements et nos ateliers."
>
	<main id="main-content">
		<!-- 1. Hero : Association & Le lieu d'accueil -->
		<Hero />

		<!-- 2. Présentation : L'histoire, l'humani'Terre & la Maison de l'Hospitalité -->
		<About />

		<!-- 3. Valeurs : Notre vision citoyenne & interculturelle -->
		<Values />

		<!-- 4. Le Tiers-Lieu Café : Vivant, chaleureux & engagé -->
		<CafeSection />

		<!-- 5. Événements à venir : La programmation du tiers-lieu -->
		<UpcomingEvents limit={3} showViewAll={true} />

		<!-- 6. Derniers articles du Blog : Récits, retours d'expériences & vie associative -->
		<LatestPosts limit={3} />

		<!-- 7. Privatisation / Location de salle : Mise à disposition de l'espace -->
		<LocationCta />

		<!-- 8. Agir avec nous : Devenir bénévole ou faire un don -->
		<GetInvolved />
	</main>
</Layout>
