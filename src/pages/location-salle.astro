---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import salleObt from "../assets/images/salle-obt.webp";
import sceneObt from "../assets/images/scene.webp";

// Données structurées JSON-LD
const serviceJsonLd = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Location de salle et privatisation",
    provider: {
        "@type": "Organization",
        name: "Off The Beaten Tracks - OBT Café",
        address: {
            "@type": "PostalAddress",
            streetAddress: "236 Cours Lafayette",
            addressLocality: "Lyon",
            postalCode: "69003",
            addressCountry: "FR",
        },
    },
    description:
        "Privatisation de l'OBT Café à Lyon pour réunions, formations ou événements (80m², 40 personnes assises).",
};
---

<Layout
    title="Location de salle & Privatisation - OBT Café Lyon"
    description="Organisez votre réunion, formation ou événement à l'OBT Café (Lyon 3e). Découvrez nos espaces de 80m² et nos tarifs adaptés pour associations et entreprises."
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(serviceJsonLd)}
        slot="head"
    />

    <!-- Fil d'Ariane -->
    <nav
        aria-label="Fil d'ariane"
        class="bg-obt-light/80 py-3 border-b border-obt-muted/10"
    >
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-obt-muted"
        >
            <ol class="flex items-center space-x-2">
                <li>
                    <a href="/" class="hover:text-cafe-text transition-colors"
                        >Accueil</a
                    >
                </li>
                <li class="flex items-center space-x-2">
                    <span class="text-obt-muted/40">/</span>
                    <a
                        href="/le-cafe"
                        class="hover:text-cafe-text transition-colors"
                        >Le Café</a
                    >
                </li>
                <li class="flex items-center space-x-2">
                    <span class="text-obt-muted/40">/</span>
                    <span class="text-cafe-text font-bold" aria-current="page"
                        >Location de salle</span
                    >
                </li>
            </ol>
        </div>
    </nav>
    <!-- Hero Section Location de Salle -->
    <section class="py-12 md:py-20 bg-cafe-light border-b border-cafe/20">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-6">
                <span
                    class="inline-block px-4 py-1.5 rounded-full bg-cafe-text text-white font-extrabold text-xs tracking-wider uppercase shadow-sm"
                >
                    ☕ Privatisation de l'OBT Café
                </span>
                <h1
                    class="text-4xl sm:text-5xl font-extrabold tracking-tight text-obt-dark leading-tight font-serif"
                >
                    Louez notre espace pour vos <span class="text-cafe-text"
                        >événements</span
                    >
                </h1>
                <p class="text-lg text-obt-muted leading-relaxed">
                    Vous souhaitez organiser une réunion, une formation, un
                    atelier ou un événement associatif à l’OBT Café ? Notre
                    tiers-lieu modulable de 80m² au cœur de Lyon s'adapte à tous
                    vos projets.
                </p>
                <div class="pt-2">
                    <a
                        href="#tarifs"
                        class="inline-block px-6 py-3 rounded-full bg-cafe-text text-white font-bold text-xs hover:opacity-90 transition-all shadow-sm"
                    >
                        Découvrir nos formules et tarifs
                    </a>
                </div>
            </div>
            <div
                class="rounded-3xl overflow-hidden shadow-sm border border-cafe/20"
            >
                <Image
                    src={salleObt}
                    alt="Vue générale de la salle de l'OBT Café"
                    width={800}
                    height={533}
                    class="w-full h-auto object-cover"
                    loading="eager"
                />
            </div>
        </div>
    </section>

    <!-- Section Immersion & Équipements (Refondue avec de l'âme et des photos) -->
    <section class="py-20 bg-white border-y border-obt-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span
                    class="text-cafe-text font-bold text-xs tracking-widest uppercase bg-cafe-light px-4 py-1.5 rounded-full border border-cafe/20"
                >
                    Un cadre chaleureux et équipé
                </span>
                <h2
                    class="text-3xl sm:text-4xl font-extrabold text-obt-dark font-serif"
                >
                    Tout le confort d'un tiers-lieu engagé pour vos participants
                </h2>
                <p class="text-obt-muted text-sm sm:text-base">
                    Pensé pour favoriser les échanges, notre espace associe la
                    convivialité d'un café associatif aux équipements
                    professionnels nécessaires au bon déroulement de vos
                    sessions.
                </p>
            </div>

            <!-- Grille visuelle avec photos et points forts -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
                <div
                    class="rounded-3xl overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.04)] border border-obt-border bg-cafe-light/20"
                >
                    <Image
                        src={sceneObt}
                        alt="Espace scène et équipements audio de l'OBT Café"
                        width={700}
                        height={466}
                        class="w-full h-auto object-cover"
                    />
                </div>
                <div class="space-y-6">
                    <h3 class="text-2xl font-bold text-obt-dark font-serif">
                        Une configuration pensée pour le partage et la culture
                    </h3>
                    <p class="text-obt-muted text-sm leading-relaxed">
                        Que ce soit pour une conférence intimiste, une assemblée
                        générale, un concert acoustique ou une formation
                        professionnelle, l'espace se réagence facilement selon
                        vos envies.
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div
                            class="p-4 rounded-2xl bg-cafe-light/40 border border-cafe/15 space-y-1"
                        >
                            <span class="text-lg">🎤</span>
                            <h4 class="font-bold text-obt-dark text-sm">
                                Petite scène & Sonorisation
                            </h4>
                            <p class="text-xs text-obt-muted">
                                Idéal pour les prises de parole, performances et
                                projections.
                            </p>
                        </div>
                        <div
                            class="p-4 rounded-2xl bg-cafe-light/40 border border-cafe/15 space-y-1"
                        >
                            <span class="text-lg">📚</span>
                            <h4 class="font-bold text-obt-dark text-sm">
                                Ambiance chaleureuse
                            </h4>
                            <p class="text-xs text-obt-muted">
                                Accès à la bibliothèque et mobilier modulable en
                                bois.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liste détaillée des équipements sous forme de cartes épurées -->
            <div
                class="bg-cafe-light/30 p-8 sm:p-10 rounded-3xl border border-cafe/20 space-y-8"
            >
                <h3
                    class="text-xl font-bold text-obt-dark text-center font-serif"
                >
                    Ce que comprend systématiquement la privatisation :
                </h3>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm text-obt-muted"
                >
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">📐</span>
                        <span>Espace de <strong>80 m²</strong></span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">🪑</span>
                        <span><strong>40 personnes</strong> assises</span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">📶</span>
                        <span>Connexion <strong>WiFi</strong> haut débit</span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">📽️</span>
                        <span><strong>Écran</strong> de projection</span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">💧</span>
                        <span><strong>Point d'eau</strong> disponible</span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">🪑</span>
                        <span>Tables et chaises fournies</span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">📚</span>
                        <span>Accès bibliothèque</span>
                    </div>
                    <div
                        class="flex items-center gap-3 bg-white p-4 rounded-2xl shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/10"
                    >
                        <span class="text-xl">🌿</span>
                        <span>Tiers-lieu lumineux</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Grilles Tarifaires (Sans les CTA redondants à l'intérieur) -->
    <section id="tarifs" class="py-20 bg-cafe-light/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
            <span
                class="text-cafe-text font-bold text-xs tracking-widest uppercase bg-cafe-light px-4 py-1.5 rounded-full border border-cafe/20"
                >Tarification</span
            >
            <h2
                class="text-3xl sm:text-4xl font-extrabold text-obt-dark tracking-tight mt-3 font-serif"
            >
                Nos formules de location
            </h2>
            <p class="text-obt-muted text-sm mt-2">
                Des tarifs solidaires et adaptés selon votre structure.
            </p>
        </div>

        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-3 gap-8"
        >
            <!-- Association Résidente -->
            <div
                class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.03)] border border-obt-border flex flex-col justify-between space-y-6"
            >
                <div>
                    <span
                        class="text-xs font-bold uppercase tracking-wider text-cafe-text bg-cafe-light px-3 py-1 rounded-full border border-cafe/20"
                        >Tarif préférentiel</span
                    >
                    <h3
                        class="text-2xl font-bold text-obt-dark mt-4 font-serif"
                    >
                        Association résidente
                    </h3>

                    <ul class="mt-6 space-y-3 text-sm text-obt-muted">
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Demi-journée (&le; 4h) :</span>
                            <span class="font-bold text-obt-dark">40 €</span>
                        </li>
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Journée complète (&le; 8h) :</span>
                            <span class="font-bold text-obt-dark">80 €</span>
                        </li>
                        <li class="flex justify-between pb-2">
                            <span>Soirée (dès 18h) :</span>
                            <span class="font-bold text-obt-dark">80 €</span>
                        </li>
                    </ul>

                    <div
                        class="mt-6 pt-4 border-t border-obt-border space-y-2 text-xs text-obt-muted"
                    >
                        <p class="font-semibold text-obt-dark">Suppléments :</p>
                        <p>• Vidéoprojecteur : 10 €</p>
                        <p>• Sono : 20 €</p>
                        <p>• Service bar / Présence OBT : 25 €/h</p>
                    </div>
                </div>
            </div>

            <!-- Association Extérieure -->
            <div
                class="bg-white p-8 rounded-3xl shadow-[0_14px_36px_rgba(0,0,0,0.06)] border-2 border-cafe flex flex-col justify-between space-y-6 relative"
            >
                <div
                    class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-cafe-text text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wide shadow-sm"
                >
                    Populaire
                </div>
                <div>
                    <span
                        class="text-xs font-bold uppercase tracking-wider text-cafe-text bg-cafe-light px-3 py-1 rounded-full border border-cafe/20"
                        >Partenaires & Tiers</span
                    >
                    <h3
                        class="text-2xl font-bold text-obt-dark mt-4 font-serif"
                    >
                        Association extérieure
                    </h3>

                    <ul class="mt-6 space-y-3 text-sm text-obt-muted">
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Demi-journée (&le; 4h) :</span>
                            <span class="font-bold text-obt-dark">80 €</span>
                        </li>
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Journée complète (&le; 8h) :</span>
                            <span class="font-bold text-obt-dark">150 €</span>
                        </li>
                        <li class="flex justify-between pb-2">
                            <span>Soirée (dès 18h) :</span>
                            <span class="font-bold text-obt-dark">150 €</span>
                        </li>
                    </ul>

                    <div
                        class="mt-6 pt-4 border-t border-obt-border space-y-2 text-xs text-obt-muted"
                    >
                        <p class="font-semibold text-obt-dark">Suppléments :</p>
                        <p>• Vidéoprojecteur : 20 €</p>
                        <p>• Sono : 30 €</p>
                        <p>• Service bar / Présence OBT : 40 €/h*</p>
                        <p
                            class="text-[10px] italic text-cafe-text font-medium"
                        >
                            * obligatoire après 20h
                        </p>
                    </div>
                </div>
            </div>

            <!-- Entreprise -->
            <div
                class="bg-white p-8 rounded-3xl shadow-[0_10px_30px_rgba(0,0,0,0.03)] border border-obt-border flex flex-col justify-between space-y-6"
            >
                <div>
                    <span
                        class="text-xs font-bold uppercase tracking-wider text-obt-dark bg-obt-border px-3 py-1 rounded-full"
                        >Professionnel</span
                    >
                    <h3
                        class="text-2xl font-bold text-obt-dark mt-4 font-serif"
                    >
                        Entreprise
                    </h3>

                    <ul class="mt-6 space-y-3 text-sm text-obt-muted">
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Demi-journée (&le; 4h) :</span>
                            <span class="font-bold text-obt-dark">100 €</span>
                        </li>
                        <li
                            class="flex justify-between border-b border-obt-border pb-2"
                        >
                            <span>Journée complète (&le; 8h) :</span>
                            <span class="font-bold text-obt-dark">200 €</span>
                        </li>
                        <li class="flex justify-between pb-2">
                            <span>Soirée (dès 18h) :</span>
                            <span class="font-bold text-obt-dark">200 €</span>
                        </li>
                    </ul>

                    <div
                        class="mt-6 pt-4 border-t border-obt-border space-y-2 text-xs text-obt-muted"
                    >
                        <p class="font-semibold text-obt-dark">Suppléments :</p>
                        <p>• Vidéoprojecteur : 50 €</p>
                        <p>• Sono : 60 €</p>
                        <p>• Service bar / Présence OBT : 70 €/h*</p>
                        <p class="text-[10px] italic text-obt-dark font-medium">
                            * obligatoire après 20h
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Final Unifié -->
    <section class="py-16 bg-white text-center border-t border-obt-border">
        <div class="max-w-3xl mx-auto px-4 space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-obt-dark font-serif">
                Prêt à organiser votre événement chez nous ?
            </h2>
            <p class="text-obt-muted text-sm sm:text-base leading-relaxed">
                Contactez directement l'équipe pour vérifier les disponibilités,
                valider votre formule et configurer la salle selon vos besoins
                spécifiques.
            </p>
            <div>
                <a
                    href="/contact"
                    class="inline-block px-8 py-3.5 rounded-full bg-cafe-text text-white font-semibold text-xs hover:opacity-95 transition-all shadow-[0_4px_14px_rgba(168,83,56,0.2)]"
                >
                    Contactez-nous pour réserver ➔
                </a>
            </div>
            <div
                class="mt-8 text-center bg-cafe-light/30 p-6 rounded-3xl border border-cafe/20 max-w-xl mx-auto"
            >
                <p class="text-obt-muted text-sm mb-4">
                    Besoin de conserver le document officiel avec toutes les
                    conditions sur votre appareil ?
                </p>
                <a
                    href="/docs/tarifs-location-obt.pdf"
                    download
                    class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-cafe-text font-semibold hover:bg-cafe-light transition-all shadow-[0_4px_12px_rgba(0,0,0,0.02)] border border-cafe/30 text-xs"
                >
                    <span>📥 Télécharger la plaquette des tarifs (PDF)</span>
                </a>
            </div>
        </div>
    </section>
</Layout>
