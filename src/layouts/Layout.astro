---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    type?: string;
}

const {
    title,
    description = "OBT Café - Un café associatif, culturel et interculturel au cœur de Lyon.",
    image = "/images/og-default.jpg",
    type = "website",
} = Astro.props;

const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site || "https://offthebeatentracks.fr",
);
const socialImageUrl = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalURL} />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageUrl} />

        <!-- Twitter Card -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageUrl} />

        <title>{title}</title>
        <!-- Dans src/layouts/Layout.astro, à l'intérieur du <head> -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-obt-light text-obt-dark min-h-screen flex flex-col font-sans selection:bg-obt-primary selection:text-white"
    >
        <!-- Slot pour le Header -->
        <Header />

        <!-- Contenu principal -->
        <main class="flex-grow">
            <slot />
        </main>

        <!-- Slot pour le Footer -->
        <Footer slot="footer" />
    </body>
</html>
